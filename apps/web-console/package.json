{
  "name": "@palai/web-console",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @palai/sdk build",
    "dev": "next dev -p 3200",
    "prebuild": "pnpm --filter @palai/sdk build",
    "build": "next build",
    "start": "next start -p 3200",
    "pretypecheck": "pnpm --filter @palai/sdk build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "next build && playwright test",
    "test:e2e:real": "PALAI_CONSOLE_PROFILE=real next build && PALAI_CONSOLE_PROFILE=real playwright test",
    "sweep": "node --test tests/conformance.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@palai/sdk": "workspace:*",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.51.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2"
  }
}
