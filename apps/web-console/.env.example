# The console reads these SERVER-SIDE only. The API key must NEVER carry a NEXT_PUBLIC_ prefix —
# it lives solely in the server-side relay (app/api/palai/**) and never reaches the browser.
PALAI_BASE_URL=http://127.0.0.1:8080
PALAI_API_KEY=palai-sk-...

# THE OPERATOR PASSWORD, AS A HASH — and WITHOUT IT THE CONSOLE SERVES NOTHING (every relay method answers
# 503 console_not_configured). This is not a credential the console presents anywhere; it is what an operator
# password is compared against, and the session cookie's signing key is derived from it — so changing it
# invalidates every live session, which is the only revocation this design has.
#
# Generate it with the password on STDIN, never in argv:
#     printf %s 'a-long-console-password' | node scripts/hash-password.mjs >> .env.local
#
# The key BEHIND this door is a separate concern and T1 does not narrow it: an empty scope set is unlimited
# (api/middleware/auth.go:31-34). See docs/operations/console.md §3 for the narrow-key recipe.
PALAI_CONSOLE_PASSWORD_HASH=scrypt$16384$8$1$...$...

# Pointing at a self-hosted TLS edge that serves a private-CA certificate is a zero-code change:
# set PALAI_BASE_URL to the edge and trust its CA server-side with NODE_EXTRA_CA_CERTS=<path-to-ca.crt>
# (Node's global fetch honors it). The relay code never touches the credential path.
# NODE_EXTRA_CA_CERTS=/path/to/ca.crt
