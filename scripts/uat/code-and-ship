#!/usr/bin/env bash
# Code-and-ship UAT — the E22 EXIT gate (plan §T7). One target, a Docker-free CORE + a Docker-bound JOURNEY
# tier + a CREDENTIAL-gated live tier, shaped exactly like E21's `tools-memory`. The core is the load-bearing
# gate: it needs no Docker and no credential.
#
# WHY THIS TARGET CO-RUNS THE BACKING SUITES (the E17 T11 review's MUST-FIX 1, inherited verbatim through
# E19, E20 and E21): the bundle's per-case `status` is AUTHORED deterministic data. Only the entries carrying
# a proof block can be judged by a verifier; the rest carry shape fields alone. So `evidence-verify` on its
# own certifies "UAT declared green", NOT "UAT green". THIS SCRIPT is what makes the authored status honest:
# the SAME invocation that verifies the bundle also RUNS the suites that back the five cases it certifies. A
# red backing suite fails this target, and TestARedBackingSuiteFailsTheCodeAndShipGate proves that
# mechanically via PALAI_SHIP_FAULT_SUITE.
#
#   Docker-free core (always):
#     1. go test ./tests/uat/code-and-ship/... — four gates in one package:
#        a. the committed code-and-ship-0.1.0 bundle is BYTE-identical to its generator and verifies clean
#           through the SHIPPED verifier;
#        b. the REFUSAL matrix: shape-consistent manifests claiming a property they did not earn, every one
#           REFUSED — including a DENIED publication marked published, a publish schema carrying a `base`
#           property, and a ticket body whose tool name turns up in the advertised set;
#        c. the promote gate: rc PASSES, stable is REFUSED, a dropped claim marker still routes HERE, an
#           `apple-build` tier that ADVANCED is REFUSED, and no iOS/Jira identifier exists in shipped code;
#        d. the five cases' catalog, checked against the tree, plus the CAS- orphan sweep.
#     2. the HOST EXECUTOR's own guards + the publish/tool surface + the Slack adapter — the environment
#        allow-list, the ReadOnly refusal, the process-group kill, the two publish schemas, the upload's
#        content-sniffed extension and the task card's sources (no Docker, no credential).
#     3. evidence-verify RELEASE=code-and-ship-0.1.0 through the shipped command (0/0/0/0).
#     4. the automation catalog corpus (the tenancy half runs in the journey tier — it NEEDS a real Postgres
#        and reports `ok` over five skips without one). E22 adds THREE case.yaml files and edits two, so it is
#        not optional; the operator-doc corpus runs beside it because this epic's ceilings live in two pages.
#
#   Journey tier (Docker, no credential — SKIP_JOURNEYS=1 to opt out):
#     5. against a throwaway Postgres: the E22 narrative where its seams already live — a Slack thread bound
#        to a repository -> the coding tools granted only because it was bound -> a Jira ticket body that
#        earns five refusals -> a push and a draft pull request that WAIT for an approve, and a deny that
#        prevents the effect -> an artifact delivered to the thread as a real FILE. Plus the TENANCY corpus,
#        which needs this tier's real Postgres to run at all.
#
#   Live tier (credentials/hardware from .env.local — `make uat-code-and-ship-live`):
#     6. every leg in uat.WiringLiveLegs, unchanged, PLUS this epic's four roots — tests/live/repository,
#        tests/live/workspace, tests/live/code-and-ship and the Mac host legs. Each SKIPS with the name of the
#        missing variable, so a PARTIAL handover reports partial-green rather than a red wall.
#
# HONEST CEILING (plan §6), and it is in this release's NAME: `code-and-ship`, not "shipped an app". Every
# counterparty is a documented FAKE — a fake Slack, a fake GitHub App publisher, a fake MCP peer, a fake
# provider. What this gate certifies is: a Slack thread that can be BOUND to a repository, a model that can
# WRITE code and cannot PUBLISH it, a destination that comes from the binding and not from the model, an
# agent whose capability is the capability of the MACHINE it runs on, and no byte from outside gaining
# authority. NO TIER ADVANCES — `slack` closes PREVIEW, `knowledge-vector` and `apple-build` close DISABLED.
#
# AND THE PRICE, SAID HERE TOO BECAUSE AN OPERATOR RUNS THIS: in the native shell posture THERE IS NO SANDBOX
# and no egress backstop. The boundary is the uid. The operating rule is the only mitigation there is —
# different customers -> different Macs (or different uids); same customer -> one Mac, per-session
# directories plus `simctl --set`.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"

echo "uat-code-and-ship: [1/4] the E22 bundle + refusal matrix + promote gate + catalog + orphan sweep" >&2
go test -count=1 ./tests/uat/code-and-ship/...

echo "uat-code-and-ship: [2/4] the host executor + the publish/tool surface + the Slack adapter" >&2
# -v because EXIT 0 IS NOT PROOF. CAS-002's schema guard, CAS-004's content-sniffed extension and CAS-005's
# environment allow-list all live here, and a reader has to be able to see them RUN — a package that compiled
# to zero matching tests exits 0 exactly like a package whose tests all passed.
go test -count=1 -v ./adapters/sandboxes/host/... ./adapters/integrations/slack/... \
  ./apps/control-plane/internal/execution/tools/

echo "uat-code-and-ship: [3/4] evidence-verify RELEASE=code-and-ship-0.1.0 (want 0 failed / 0 missing / 0 secret)" >&2
RELEASE=code-and-ship-0.1.0 scripts/evidence/verify

echo "uat-code-and-ship: [4/4] the automation catalog corpus + the operator-doc corpus" >&2
# E22 adds THREE case.yaml files (CAS-001/003/005) and edits two (CAS-002/004), so the catalog corpus is not
# optional — the re-verify rule this repository learned the hard way. tests/docs is here because this epic's
# ceilings are stated in docs/operations/palai-on-a-mac.md and docs/operations/mac-sessions.md, and a page
# that stopped matching the code is how an operating rule quietly becomes wrong.
go test -count=1 ./tests/uat/automation/... ./tests/docs/...
# The TENANCY corpus is the other half of the re-verify rule, and it is NOT run here: all five of its tests
# t.Skip without PALAI_SECURITY_POSTGRES_URL, so a plain `go test` reports `ok` over five skips — a green
# that certifies nothing. It runs in the JOURNEY tier below, against the throwaway Postgres that tier already
# stands up. E22 opened NO migration, but it did add case.yaml files, so it is not optional.

# ---- the journey tier: real PostgreSQL, no credential -------------------------------------------------------
journeys="the E22 backing suites CO-RUN green (repository binding, publication approval, ticket refusals, upload)"
if [ "${SKIP_JOURNEYS:-0}" = "1" ]; then
  # Said plainly, because the closing line must never imply a tier that did not run.
  echo "uat-code-and-ship: the Docker-bound tier is SKIPPED (SKIP_JOURNEYS=1) — the backing component suites" >&2
  echo "  did NOT run; this invocation does not back the bundle's authored PASS for them" >&2
  journeys="Docker-bound backing suites NOT RUN (SKIP_JOURNEYS=1)"
else
  if ! command -v docker >/dev/null 2>&1; then
    echo "uat-code-and-ship: docker is not available; the E22 backing suites need a throwaway Postgres" >&2
    exit 2
  fi
  image="postgres@sha256:17e67d7b9890c99b055ba1e0d5c5be4ec27c9d3a72bda32db24a5e5d8a85af0c"
  label="io.palai.uat=code-and-ship"
  container="palai-uat-ship-$$-${RANDOM}"
  # Throwaway local credential, generated per run; never written to a file, never echoed.
  password="palai-uat-ship-${RANDOM}${RANDOM}"
  cleanup() { docker rm -f "$container" >/dev/null 2>&1 || true; }
  before="$(docker ps -aq --filter "label=$label" | sed '/^$/d' | wc -l | tr -d ' ')"
  trap cleanup EXIT

  docker run --detach --pull=never --name "$container" --label "$label" \
    --env POSTGRES_DB=palai --env POSTGRES_PASSWORD="$password" \
    --publish 127.0.0.1::5432 "$image" >/dev/null
  ready=0
  for _ in $(seq 1 120); do
    if docker exec "$container" pg_isready --username postgres --dbname palai >/dev/null 2>&1; then ready=1; break; fi
    sleep 0.25
  done
  if test "$ready" -ne 1; then
    docker logs "$container" >&2 || true
    echo "uat-code-and-ship: the journey postgres did not become ready" >&2
    exit 1
  fi
  binding="$(docker port "$container" 5432/tcp)"; port="${binding##*:}"

  url="postgres://postgres:$password@127.0.0.1:$port/palai?sslmode=disable"
  # A DEAD Postgres for the fault knob: reachable-looking, connects to nothing. PALAI_SHIP_FAULT_SUITE points
  # ONE backing suite at it so TestARedBackingSuiteFailsTheCodeAndShipGate can prove a red backing suite makes
  # this target exit non-zero — the guarantee the whole co-run rests on.
  dead_url="postgres://postgres:$password@127.0.0.1:1/palai?sslmode=disable"

  echo "uat-code-and-ship: [journey] the tenancy corpus against real PostgreSQL (E22 adds case.yaml files)" >&2
  set +e
  PALAI_SECURITY_POSTGRES_URL="$url" go test -tags=security -count=1 -v ./tests/security/tenancy
  tenancy_status=$?
  set -e
  if test "$tenancy_status" -ne 0; then
    echo "uat-code-and-ship: the tenancy corpus FAILED — a new case.yaml must re-run it" >&2
    cleanup; trap - EXIT
    exit "$tenancy_status"
  fi

  # The BACKING suites. The -run selectors are the SHIPPED ones from scripts/test/component where one exists,
  # verbatim: these packages also hold suites this epic does not own, and running them here would make the
  # gate's runtime somebody else's problem.
  #
  # NAMING EACH TEST IS LOAD-BEARING and it is the reason this comment exists: an unnamed test in an
  # allow-list tier is a test that never runs, and this repository has shipped that defect more than a dozen
  # times — twice in E21 alone, and once again inside E22 (a `-run` pointed at the wrong PACKAGE matches
  # nothing at all and exits 0 in silence). Every selector below was checked by RUNNING it and reading
  # `=== RUN`, not by reading the string.
  #
  # THE FIRST ENTRY NEEDS NO POSTGRES and that is deliberate: the native-shell posture is the one component
  # suite in this repository that must not require a container, because what it proves is that the control
  # plane reaches the HOST's toolchain.
  #
  # THE STORE-PACKAGE ENTRY WAS HERE AND IS GONE (cutover, 2026-08-05): eight TestSlack* names, ALL of them
  # permanently deleted with the in-process Slack bridge (81aada0f), so the entry matched ZERO tests and
  # exited 0 in silence — this repository's signature failure, inside the very script written to name it.
  # CAS-001/CAS-002/CAS-004's claims moved with it, and each is checked here for where it actually landed:
  #   - CAS-001's repository binding is now cmd/cli/internal/stack/up_repository_test.go, which is UNTAGGED
  #     (no `component` build tag, no Postgres — httptest fakes) and already rides plain `go test` under
  #     `make verify`, so it needs no entry in this Docker-bound tier.
  #   - CAS-002's approval chain RE-EARNED off Slack: TestPublicationFromSlack* renamed to TestPublication*
  #     in the SAME file (apps/control-plane/internal/execution/publish_approval_component_test.go), which
  #     the second entry below already selects.
  #   - CAS-004's artifact-scoping claim is TestReadRunArtifactRefusesForeignRunsForeignTenantsAndOversize,
  #     apps/control-plane/internal/artifacts, and it is NOT added below on purpose: openArtifactsHarness
  #     (artifacts_component_test.go) requires BOTH PALAI_COMPONENT_POSTGRES_URL and PALAI_S3_ENDPOINT, and
  #     t.Skip's cleanly on either being absent — this journey tier stands up Postgres alone. Naming it here
  #     without the SeaweedFS container this package's own doc comment requires would make it SKIP rather
  #     than run, reporting green over nothing exactly like the entry this comment replaces. Its real home is
  #     `make test-component TEST=artifacts`, a DIFFERENT gate this UAT target does not re-run; recorded here
  #     as an honest ceiling rather than a silent SKIP.
  suites=(
    "./apps/control-plane/internal/execution/tools|TestNativeShellPostureRunsTheHostsOwnToolchain|TestNativeShellPostureSeparatesConcurrentSessionsOnOneMac|TestShellToolStillFailsCleanlyWithNoPostureConfigured"
    "./apps/control-plane/internal/execution|TestPublication"
    "./apps/control-plane/internal/extensions|TestJiraTicketBodyCannotInstructTheAgent"
  )
  status=0
  for entry in "${suites[@]}"; do
    suite="${entry%%|*}"
    selector="${entry#*|}"
    suite_url="$url"
    if [ "${PALAI_SHIP_FAULT_SUITE:-}" = "$suite" ]; then
      suite_url="$dead_url"
      echo "uat-code-and-ship: FAULT INJECTED — $suite points at a DEAD Postgres; this run MUST fail" >&2
    fi
    echo "uat-code-and-ship: [journey] backing suite $suite" >&2
    set +e
    PALAI_COMPONENT_POSTGRES_URL="$suite_url" \
      go test -tags=component -count=1 -v -run "$selector" "$suite"
    status=$?
    set -e
    if test "$status" -ne 0; then
      echo "uat-code-and-ship: backing suite $suite FAILED — the bundle's authored PASS for its cases is not honest" >&2
      docker logs "$container" >&2 || true
      break
    fi
  done

  cleanup
  trap - EXIT
  after="$(docker ps -aq --filter "label=$label" | sed '/^$/d' | wc -l | tr -d ' ')"
  if test "$after" -ne "$before"; then
    echo "uat-code-and-ship: the journey tier leaked a container" >&2
    exit 1
  fi
  if test "$status" -ne 0; then exit "$status"; fi
fi

# ---- the live tier: credential/hardware-gated, NO CODE CHANGES ----------------------------------------------
live="live legs NOT RUN (RUN_LIVE unset)"
if [ "${RUN_LIVE:-0}" = "1" ]; then
  if [ -f .env.local ]; then
    set -a
    # shellcheck disable=SC1091
    . ./.env.local
    set +a
  fi
  echo "uat-code-and-ship: the credential/hardware-gated live legs — each SKIPS by name if its variable is absent" >&2
  # -v so a SKIP is VISIBLE: this family's signature failure is a green report over legs that never ran. The
  # Mac legs are the ones that need HARDWARE rather than a credential — a real Xcode and a real simulator —
  # and they are the only proof that "the agent runs the host's own tools" is more than a container's absence.
  go test -tags=live -count=1 -v ./tests/live/slack/... ./tests/live/repository/... \
    ./tests/live/workspace/... ./tests/live/code-and-ship/... \
    ./apps/control-plane/internal/execution/tools/live/... ./adapters/integrations/mcp/
  live="live legs attempted (read the SKIP lines above: a skip is not a pass)"
fi

echo "uat-code-and-ship=PASS (E22 exit gate: bundle 0/0/0/0, the unapproved-publication count re-derived from" >&2
echo "  the ledger, the destination count re-derived from the two publish tools' schemas, and the" >&2
echo "  typed-operation ceiling recomputed from workers/catalog.go's own source, $journeys, $live)" >&2
echo "uat-code-and-ship: NO TIER ADVANCED — \`slack\` closes PREVIEW, \`knowledge-vector\` and \`apple-build\`" >&2
echo "  close DISABLED. Every counterparty is a FAKE. THE PRICE OF THIS EPIC IS A DELETED BOUNDARY: in the" >&2
echo "  native shell posture there is NO SANDBOX and no egress backstop — the boundary is the uid, and the" >&2
echo "  operating rule is the only mitigation there is (different customers -> different Macs; same customer" >&2
echo "  -> one Mac, per-session directories plus \`simctl --set\`)." >&2
