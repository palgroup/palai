# The packaged suite proves the outside-the-tree bring-up: a `palai` binary whose working directory
# has no deploy/ above it brings up a real stack and every doctor check goes green.
#
# It builds the three images HERE because nothing is published — release.yml's publish step is the
# credential-less dry run (plan §6 leg 2) — so a packaged bring-up can only be driven with locally
# built ones. They are built SERIALLY and for the host platform only: no buildx, no --platform, no
# emulation. The Dockerfile paths and contexts are compose.yaml's own (context ../.. from
# deploy/compose is this repo root).
#
# The engine tag is handed to the test as a TAG, not a digest. That is deliberate: resolving it to
# the bare sha256 config digest the runner's lease requires is part of what the packaged path does,
# and passing a digest here would test around it.
run_packaged() {
  docker build -q -f deploy/compose/control-plane.Dockerfile -t palai/control-plane:local . >/dev/null
  docker build -q -f deploy/compose/runner.Dockerfile -t palai/runner:local . >/dev/null
  docker build -q -t palai/reference-engine:local engines/reference >/dev/null

  # -run names the test EXPLICITLY, and the name below is the allow-list: a bring-up proof this
  # list does not name is a proof that never runs.
  PALAI_PACKAGED_IMAGES="palai/control-plane:local,palai/runner:local,palai/reference-engine:local" \
    go test -tags=component -count=1 -v \
      -run 'TestPackagedStackComesUpOutsideTheTree' ./cmd/cli
  echo "component_packaged=PASS"
}

# The native-shell suite is the ONE component suite that needs no Docker and no Postgres, and that is
# the measurement it exists to carry (E22 T1): a Mac deployment runs the control plane NATIVELY, so
# the proof that the agent reaches the host's own toolchain must not itself require a container.
#
# -run names the tests EXPLICITLY, and the list below is the allow-list: a proof this list does not
# name is a proof that never runs, and this tier has shipped green-by-omission before.
run_native_shell() {
  go test -tags=component -count=1 -v \
    -run 'TestNativeShellPostureRunsTheHostsOwnToolchain|TestNativeShellPostureSeparatesConcurrentSessionsOnOneMac|TestShellToolStillFailsCleanlyWithNoPostureConfigured|TestAnEnvironmentValueReachesTheAgentsShellAndTheHostsDoesNot|TestAnEnvironmentKeyCannotShadowTheSandboxsOwnPATH|TestAWallTimeExpiryTellsTheModelWhatHappened' \
    ./apps/control-plane/internal/execution/tools
  # The COMPOSITION ROOT's own half: the wall time both postures run under comes from an environment
  # variable that was set in no shipped file, and unset meant two opposite broken things (unbounded on
  # the host, every call refused in the container). These two are untagged and ride `make verify`; they
  # are named here because this suite is what a Mac operator runs before trusting the posture, and the
  # posture's bound is part of it. Same allow-list discipline as every -run above.
  go test -count=1 -v \
    -run 'TestTheNativePostureBoundsAShellCallWithNoEnvironmentSet|TestTheSandboxPostureAcceptsItsOwnLimitsWithNoEnvironmentSet' \
    ./apps/control-plane/cmd/palai-control-plane
  # The host executor's own guards (environment allow-list, ReadOnly refusal, process-group kill) are
  # untagged and ride `make verify`; they are re-run here because this suite is what a Mac operator
  # runs before trusting the posture.
  go test -count=1 -v ./adapters/sandboxes/host
  # The DEPLOYMENT half (E22 T5): the three facts native-control-plane.yml states in prose, refused by
  # name before any Docker work, and the teardown that stops the native process instead of orphaning
  # it. Same allow-list discipline — a guard this -run does not name is a guard this tier never runs.
  go test -count=1 -v \
    -run 'TestNativeRunnerListener|TestNativeWorkspaceRoot|TestNativeEnvironment|TestNativeStop' \
    ./cmd/cli/internal/stack
  echo "component_native_shell=PASS"
}

# The background suite proves E26 T1's container posture against a REAL Docker daemon: a container that
# is still running after the call that started it returned, a command form that interprets no
# metacharacter, and a container we cannot prove is ours that is never signalled. Every liveness claim is
# read from ContainerInspect rather than from our own bookkeeping.
#
# It pins the same busybox digest scripts/test/live-provider and scripts/uat/coding pin, because a
# background task needs a real /bin/sh and the fixture engine the runner tiers build is FROM scratch.
#
# -run names the tests EXPLICITLY, and the list below is the allow-list: a proof this list does not name
# is a proof that never runs. This tier has shipped green-by-omission six times.
run_background() {
  local shell_ref="busybox@sha256:9532d8c39891ca2ecde4d30d7710e01fb739c87a8b9299685c63704296b16028"
  local label="io.palai.sandbox"
  docker pull --quiet "$shell_ref" >/dev/null
  local image_id
  image_id="$(docker image inspect "$shell_ref" --format '{{.Id}}')"
  if [[ ! "$image_id" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo "busybox shell image id is not immutable" >&2
    exit 1
  fi

  count_sandboxes() { docker ps -aq --filter "label=$label" | sed '/^$/d' | wc -l | tr -d ' '; }
  local before after
  before="$(count_sandboxes)"

  set +e
  PALAI_SHELL_IMAGE_ID="$image_id" \
    go test -tags=component -count=1 -v \
      -run 'TestTodayAShellContainerIsGoneWhenTheCallReturns|TestADetachedContainerIsStillRunningAfterTheCallReturns|TestTheDetachedCommandFormInterpretsNoMetacharacter|TestADetachedTaskReportsItsExitCodeFromTheDaemon|TestKillingADetachedTaskRemovesTheContainerAndIsIdempotent|TestADetachedContainerWeCannotProveIsOursIsNeverSignalled' \
      ./tests/component/background
  local status=$?
  set -e

  # THE LEAK COUNT IS PART OF THE PROOF HERE, not hygiene around it: this suite deliberately starts
  # containers nothing removes on a defer, so "the tests cleaned up after themselves" is the assertion
  # that the kill path actually removes what the start path leaves.
  after="$(count_sandboxes)"
  if test "$after" -ne "$before"; then
    echo "background suite leaked a sandbox container ($before -> $after)" >&2
    docker ps -a --filter "label=$label" >&2
    exit 1
  fi
  if test "$status" -ne 0; then
    exit "$status"
  fi

  # The HOST posture's half needs no Docker and no Postgres — a Mac deployment runs the control plane
  # natively — and it is re-run here beside the container one so a single command covers both postures of
  # the same claim. Untagged, so it also rides `make verify`.
  # E26 T6 adds the tenth name, and it is a measurement of a SENTENCE this tree wrote about itself: E25
  # T3's "the value's whole life is one Execute call" is structurally false for a background task, and the
  # started process reads its own environment at a moment the TEST releases — strictly after Start
  # returned — to say so. The comment is corrected in the same commit and the test asserts the correction,
  # because a claim left to rot is what E24 T8 found written in twenty-six places.
  go test -count=1 -v \
    -run 'TestTodayAHostProcessGroupDiesWithTheAttempt|TestAHostBackgroundProcessSurvivesTheAttempt|TestABackgroundTaskWritesItsOwnLogAndCreatesTheSessionDirectory|TestAnEscapingOutputPathIsRefusedBeforeAnythingStarts|TestABackgroundTaskGetsTheSameClosedEnvironmentAsASynchronousOne|TestAFinishedBackgroundTaskReportsItsExitCodeOnlyWhenItIsKnown|TestAPgidWeCannotProveIsOursIsNeverSignalled|TestKillingABackgroundTaskTwiceIsKillingItOnce|TestTheKillReachesTheWholeProcessGroup|TestAnEnvironmentValueOutlivesTheExecuteCallThatHandedItOver' \
    ./adapters/sandboxes/host
  # The STRUCTURAL half: the detached path builds no container options of its own, and dockerDriver.Run
  # did not change by one byte while a new lifetime was added beside it.
  go test -count=1 -v \
    -run 'TestTheDetachedPathBuildsNoContainerOptionsOfItsOwn|TestTheHardenedContainerOptionsAreExactlyThese|TestDockerDriverRunIsByteUnchanged' \
    ./adapters/sandboxes/oci
  # The COMPOSITION ROOT's half: production wires a background runner for the posture it wires a shell
  # runner for. A test that builds its own executor never sees the config production builds. E26 T4 adds
  # the third name — the D14 declaration: production's own reading of PALAI_DISPATCH_WORKERS, the shipped
  # compose file's `:-0`, and the runbook's first paragraph, which have to agree or an operator's build
  # finishes and nothing ever tells the model.
  go test -count=1 -v \
    -run 'TestTheCompositionRootWiresABackgroundRunnerOnTheNativePosture|TestABackgroundRunnerIsNotWiredForAPostureThatCannotDetach|TestNoDispatchWorkerMeansNoBackgroundExitNotificationEverLands' \
    ./apps/control-plane/cmd/palai-control-plane
  echo "component_background=PASS containers=$after"
}

# The slack-bot suite proves Task 8's own thread-session store (2026-08-03 plan, apps/slack-bot's
# migrations + internal/store) against a real Postgres — the bot's own database, never Palai's: the
# throwaway container below is empty of every Palai table, so there is nothing here to confuse it with
# `run_postgres`'s `palai` schema. It reuses the run_queue idiom (one container, one dedicated package,
# its own label so the leak check counts only its own container).
#
# No -run allow-list: apps/slack-bot/internal/store is not shared with any other component suite (unlike
# extensions/execution/coordinator above, where an allow-list is what keeps one suite's tests from
# running under another's), so there is no other suite's test to accidentally pull in, and every test
# TASK 8 or a later slack-bot task adds to this package runs automatically rather than needing this
# script edited to name it — the opposite failure this file's other allow-lists guard against.
run_slack_bot() {
  local image="postgres@sha256:17e67d7b9890c99b055ba1e0d5c5be4ec27c9d3a72bda32db24a5e5d8a85af0c"
  local label="io.palai.component=slack-bot"
  local run_id="$$-${RANDOM}"
  local container="palai-component-slack-bot-$run_id"
  local volume="palai-component-slack-bot-$run_id"
  local password="palai-component-${RANDOM}${RANDOM}"

  count_containers() { docker ps -aq --filter "label=$label" | sed '/^$/d' | wc -l | tr -d ' '; }
  count_volumes() { docker volume ls -q --filter "label=$label" | sed '/^$/d' | wc -l | tr -d ' '; }
  cleanup() {
    docker rm -f "$container" >/dev/null 2>&1 || true
    docker volume rm -f "$volume" >/dev/null 2>&1 || true
  }
  local containers_before volumes_before
  containers_before="$(count_containers)"
  volumes_before="$(count_volumes)"
  trap cleanup EXIT

  docker volume create --label "$label" "$volume" >/dev/null
  docker run --detach --pull=never --name "$container" --label "$label" \
    --env POSTGRES_DB=palai --env POSTGRES_PASSWORD="$password" \
    --publish 127.0.0.1::5432 --volume "$volume:/var/lib/postgresql/data" "$image" >/dev/null
  local ready=0
  for _ in $(seq 1 120); do
    if docker exec "$container" pg_isready --username postgres --dbname palai >/dev/null 2>&1; then ready=1; break; fi
    sleep 0.25
  done
  if test "$ready" -ne 1; then docker logs "$container" >&2 || true; echo "postgres slack-bot container did not become ready" >&2; exit 1; fi
  local binding port url
  binding="$(docker port "$container" 5432/tcp)"
  port="${binding##*:}"
  url="postgres://postgres:$password@127.0.0.1:$port/palai?sslmode=disable"

  set +e
  PALAI_COMPONENT_POSTGRES_URL="$url" \
    go test -tags=component -count=1 -v ./apps/slack-bot/internal/store
  local status=$?
  set -e
  if test "$status" -ne 0; then docker logs "$container" >&2 || true; fi

  cleanup
  trap - EXIT
  local containers_after volumes_after
  containers_after="$(count_containers)"
  volumes_after="$(count_volumes)"
  if test "$containers_after" -ne "$containers_before" || test "$volumes_after" -ne "$volumes_before"; then
    echo "slack-bot component suite leaked a container or volume" >&2
    exit 1
  fi
  if test "$status" -ne 0; then exit "$status"; fi
  echo "component_slack_bot=PASS containers=$containers_after volumes=$volumes_after"
}

case "$suite" in
  postgres) run_postgres ;;
  packaged) run_packaged ;;
  queue) run_queue ;;
  runner) run_runner ;;
  artifacts) run_artifacts ;;
  repository) run_repository ;;
  remote-tools) run_remote_tools ;;
  tool-sdk) run_tool_sdk ;;
  mcp) run_mcp ;;
  skills) run_skills ;;
  hooks) run_hooks ;;
  native-shell) run_native_shell ;;
  background) run_background ;;
  slack-bot) run_slack_bot ;;
  *)
    echo "unknown component suite: $suite (known: postgres, packaged, queue, runner, artifacts, repository, remote-tools, tool-sdk, mcp, skills, hooks, native-shell, background, slack-bot)" >&2
    exit 2
    ;;
esac
