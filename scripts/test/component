#!/usr/bin/env bash
# Component test tier: exercises code against real backing services in throwaway
# Docker containers. Selected with `make test-component TEST=<suite>`; defaults to
# the postgres suite. Kept out of `make verify`/`make test-unit` (Docker-bound).
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# shellcheck source=scripts/test/runner-engine.sh
source "$root/scripts/test/runner-engine.sh"

suite="${TEST:-postgres}"

# The runner suite proves a real workspace allocation is bind-mounted into a real, digest-pinned
# engine container (spec §29.9, E09 Task 1). It reuses the fault/security fixture-engine harness,
# which cross-builds the fixture, exports PALAI_RUNNER_ENGINE_IMAGE_ID, and verifies no sandbox
# container leaks.
run_runner() {
  run_runner_suite component ./tests/component/runner
}

run_postgres() {
  # Immutable pinned image (matches the postgres-coordinator spike / ADR-0001).
  local image="postgres@sha256:17e67d7b9890c99b055ba1e0d5c5be4ec27c9d3a72bda32db24a5e5d8a85af0c"
  local label="io.palai.component=postgres"
  local run_id="$$-${RANDOM}"
  local container="palai-component-postgres-$run_id"
  local volume="palai-component-postgres-$run_id"
  # Throwaway local credential, generated per run; never written to a file.
  local password="palai-component-${RANDOM}${RANDOM}"

  count_containers() { docker ps -aq --filter "label=$label" | sed '/^$/d' | wc -l | tr -d ' '; }
  count_volumes() { docker volume ls -q --filter "label=$label" | sed '/^$/d' | wc -l | tr -d ' '; }
  cleanup() {
    docker rm -f "$container" >/dev/null 2>&1 || true
    docker volume rm -f "$volume" >/dev/null 2>&1 || true
  }

  local containers_before volumes_before
  containers_before="$(count_containers)"
  volumes_before="$(count_volumes)"
  trap cleanup EXIT

  docker volume create --label "$label" "$volume" >/dev/null
  docker run --detach --pull=never \
    --name "$container" \
    --label "$label" \
    --env POSTGRES_DB=palai \
    --env POSTGRES_PASSWORD="$password" \
    --publish 127.0.0.1::5432 \
    --volume "$volume:/var/lib/postgresql/data" \
    "$image" >/dev/null

  local ready=0
  for _ in $(seq 1 120); do
    if docker exec "$container" pg_isready --username postgres --dbname palai >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 0.25
  done
  if test "$ready" -ne 1; then
    docker logs "$container" >&2 || true
    echo "postgres component container did not become ready" >&2
    exit 1
  fi

  local binding port url
  binding="$(docker port "$container" 5432/tcp)"
  port="${binding##*:}"
  url="postgres://postgres:$password@127.0.0.1:$port/palai?sslmode=disable"

  set +e
  # PALAI_SUITE_RUN selects ONE package + test set out of this tier instead of the whole chain below.
  # The E18 T7 escape suite uses it to run a single quarantine proof against a real Postgres without
  # paying for every component leg; unset, the tier runs exactly as before. The leak accounting is the
  # SAME as the full path's and runs BEFORE the status exit — the escape suite documents that it
  # inherits each tier's container accounting, and an early return that skipped it made that false.
  if test -n "${PALAI_SUITE_RUN:-}"; then
    PALAI_COMPONENT_POSTGRES_URL="$url" \
      go test -tags=component -count=1 -run "$PALAI_SUITE_RUN" -v "${PALAI_SUITE_PKG:-./tests/component/postgres}"
    local status=$?
    set -e
    if test "$status" -ne 0; then
      docker logs "$container" >&2 || true
    fi
    cleanup
    trap - EXIT
    local selected_containers_after selected_volumes_after
    selected_containers_after="$(count_containers)"
    selected_volumes_after="$(count_volumes)"
    if test "$selected_containers_after" -ne "$containers_before" || test "$selected_volumes_after" -ne "$volumes_before"; then
      echo "postgres component suite leaked a container or volume" >&2
      exit 1
    fi
    test "$status" -eq 0 || exit "$status"
    echo "component_postgres=PASS containers=$selected_containers_after volumes=$selected_volumes_after (selected: ${PALAI_SUITE_PKG:-./tests/component/postgres} -run $PALAI_SUITE_RUN)"
    return 0
  fi
  PALAI_COMPONENT_POSTGRES_URL="$url" \
    go test -tags=component -count=1 -v ./tests/component/postgres
  local status=$?
  # The E10 Task 2 redelivery-wiring tests drive the boundary pump against this same real spine
  # (unexported pumpCommands ⇒ package execution). -run selects only the component-tagged behavior
  # tests, so the package's Docker-free unit tests are not re-run here. TestBindingConnectionRef* is
  # the E13 Task 9 MCI-007 proof: it needs this real spine AND the host's git (an authenticated local
  # HTTP git remote), so it lives with the other real-spine execution tests rather than in the
  # Docker-free repository suite. TestRemoteChild* is the E19 Task 5 wiring: a child.request naming a
  # registered a2a_remote_agents row dispatches to the REMOTE (real store + real a2a client + a
  # loopback peer), never to the local engine, and the four E17 T3 guarantees survive the wiring — a
  # test the -run list does not name is a test this tier never runs. TestBoundaryApproval* is the
  # APV-001 wiring: an approve accepted through the ordinary command path is applied by the boundary
  # pump (the branch that was unreachable while PendingBoundaryCommands filtered approve/deny out).
  # TestDispatch*Image* is the E20 vision spine: an engine frame carrying an `image_ref` content item resolves
  # to BYTES in the provider request through the production SetImageReader seam, and a stack with no object
  # store marks the image instead of dropping it silently. It is named here for the reason the sentence above
  # gives — a test the -run list does not name is a test this tier never runs, and the whole point of this one
  # is to catch a wiring that was never connected.
  #
  # TestToolApproval*/TestExpiredToolApproval* are the E23 T1 gate: a tool declared approval_required never
  # reaches Execute without a human, the run PARKS instead of answering, an approved call runs exactly once
  # and wakes the run, arguments that changed after the approval do not run, and an expired approval
  # releases the run it parked. They are named here for the reason the paragraph above gives, and this list
  # is the tripwire that reason exists for: a security test that never runs reports the same green as one
  # that passes.
  # TestPublicationFromSlack* covers E23 T3 as well as E22 T4 — the prefix already selected them, and the
  # names are worth reading because the claim changed under it: an approval message is now POSTED into the
  # thread by production code (ApprovalMessage's first production caller), the run PARKS instead of
  # answering, the approve that used to 503 lands, a deny releases the run, and a delivery Slack refuses
  # costs the human a button and never the approval, its deadline, or the run (SLK-006).
  # TestApprover* is the E23 T2 gate: WHO may approve. It drives the REAL HTTP command adapter (a scope from
  # a REAL VerifyAPIKey) into the REAL pump, and it is named here for the reason above — an approver check
  # nothing runs is an approver check nothing enforces. Its Slack twin (TestSlackApprover*) rides the
  # `TestSlack` prefix in the internal/store leg below; both halves refuse in the SAME function.
  #
  # TestAGatedMCPWrite*/TestApprovedMCPArguments*/TestAJiraTicketBodyCannotApproveItself are the E23 T5
  # write-tool gate, and they are the reason this allow-list has a paragraph rather than a name: they drive
  # the REAL orchestrator over real TLS into a fake Atlassian MCP server and measure the counter at the FAR
  # end (zero requests without a human), the identity of the bytes the peer received against the bytes the
  # approval screen showed (byte-for-byte, which is the whole meaning of every approval here), and the five
  # refusals a hostile ticket body earns. A security test this list does not name is a security test that
  # reports the same green as one that passes.
  # TestMergePullRequest* is E23 T6, and naming it here is the whole reason this list has prose: a merge is
  # the least reversible thing this system does — a push adds a branch, a PR adds a conversation, a merge
  # changes what the repository IS — so "the publisher was never called without a human" and "the head that
  # moved after the approval was NOT merged" have to actually run. They drive the real dispatcher, the real
  # Decide and the real boundary pump over a REAL Postgres; the sha-on-the-wire half is untagged in
  # adapters/repositories against a server built to GitHub's published contract.
  # TestToolWithoutApprovalDeclared* was ADDED BY E23 T7 AND IT WAS MISSING, which is this list's own trap
  # sprung one more time: `TestToolApproval` does not match `TestToolWithoutApprovalDeclaredIsBitUnchanged`
  # (Go's -run is an unanchored substring-ish regexp, and that name contains none of the eight alternatives
  # T1 added), so the one test proving an UNGATED tool is bit-unchanged never ran here. It is the
  # non-vacuity half of the whole gate: without it, a build that quietly gated EVERY tool would satisfy
  # every other assertion on this line while breaking every deployment that configured nothing.
  # TestAToolPinnedTwiceRefuses* is the hole T5 found in its OWN claim: the grant chain can offer TWO
  # bindings for one model-visible name and the lookup used to take whichever the planner emitted first,
  # so a planner's choice could decide whether a human is asked. It refuses now, at every entry point.
  #
  # TestSlackToolApproval* is E23 T8 — the DECISION SURFACE for the generic half — and it needs its own
  # alternative rather than riding one of the names above, which is this list's trap sprung deliberately
  # rather than by accident: `TestToolApproval` does NOT match `TestSlackToolApprovalAsks...` (Go's -run is
  # an unanchored regexp and "TestToolApproval" is not a substring of "TestSlackToolApproval"), and neither
  # does `TestPublicationFromSlack` or `TestApprover`. Without this word the four tests proving that a
  # gated MCP write tool can be approved AT ALL would report the same green as tests that pass.
  # What they run: the ask is posted into the correlated thread as T4's three-button ARGUMENT TABLE (not
  # E19's two-button publication screen — the screen is chosen from the approvals row's own discriminator),
  # an authorized click routes to DecideToolApproval and WAKES the parked run, an unauthorized one decides
  # nothing under EITHER approver list, a deny releases the run with a reason and runs nothing, and a
  # REGISTERED revision's operator label reaches the screen through the same lookup the executor uses.
  # This is the hole the epic's own exit gate found and filed as HIL-P8.
  #
  # TestBootstrapInstallEnrollsItsRunnerIntoTheDefaultPool is E24 T1's §2 proof — "TEK RUNNER'LI
  # DEPLOYMENT BİT-DEĞİŞMEZDİR" — and it needs its own alternative for the fourth time this list has had
  # to say so: it is the only component-tagged test in this package whose name starts with "TestBootstrap",
  # and none of the words above is a substring of it. It is the ONLY thing that proves migration 000045's
  # R6 seed plus identity.provision's actually let a runner that names no pool enrol at all; without this
  # word an upgraded install whose runner can no longer enrol would report the same green as a passing tier.
  #
  # TestStrict* is E24 T6 — STRICT ENROLMENT — and it needs its own alternative for the reason TestPoolKey does:
  # none of the words already on this list is a substring of
  # "TestStrictEnrolmentHoldsTheMachineOutOfTheRendezvousUntilAHumanApproves", so without this word the three
  # tests that hold the waiting room's claims would never run and the tier would report the same green. They
  # prove that a machine enrolling into a `strict_enrollment` pool is recorded `pending`, gets its certificate,
  # and is UNREACHABLE from a Dial until a human admits it — and that with the flag off (the default) the
  # behaviour is bit-for-bit T3's and T5's.
  # TestPoolKey* is E24 T3 — the POOL ENROLMENT KEY — and it needs its own alternative for the reason the
  # paragraph above gives one more time: none of the words on this line is a substring of
  # "TestPoolKeyRevocationLeavesAnEnrolledRunnerRenewing", so without this word the six tests that hold
  # this task's entire security claim would report the same green as tests that pass. What they run over
  # the REAL mTLS wire against a REAL Postgres: a key minted for the Mac pool admits into the Mac pool and
  # REFUSES a machine that declares the Linux pool (journalling the refusal with both pool ids), a revoked
  # key mints nothing while the machine that enrolled with it renews TWICE afterwards and its in-flight
  # lease still relays frames (the regression fence — revocation must never be a back door into SAN-011's
  # hard stop), the same key value on /v1 is a 401 that resolved no scope at all while a real API key on
  # the SAME route is a 200, and the value appears in no row, no journal detail and no log line — swept by
  # DECODING every JSONB document rather than grepping bytes, because a byte scan over an escaped or
  # encoded value can never fail and this repository shipped exactly that mistake once.
  #
  # TestPlacement* is E24 T4 — TENANT, PARK and WAKE — and it needs its own alternative because none of
  # the words on that line is a substring of "TestPlacementParksARunWhosePoolHasNoRunner". What it runs
  # against a REAL Postgres, the REAL gateway and two fake machines: tenant B's attempt is never offered
  # tenant A's machine (the runner plane had no tenant on it AT ALL before this — any enrolled runner
  # could take any tenant's attempt), a run whose pool holds no machine reaches `waiting` with ExecuteAttempt
  # returning NIL and no live attempt row (so no dispatch worker and no engine is held) instead of
  # dead-lettering in ~2.5 minutes while a Mac takes 6-20 to boot, a machine joining that pool wakes it
  # ONCE and a second machine does not wake it again, a wake does NOT reserve the machine it woke, a run
  # waiting for any OTHER reason is left alone (the guard that keeps this safe to run after every lease —
  # shown to go red when the marker predicate is removed), and the pool the placement chose is recorded on
  # the run. Without this word the whole task would report the same green as tests that pass.
  #
  # TestLifecycle* is E24 T5 — THE MACHINE LIFECYCLE — and it needs its own alternative because none of the
  # words on that line is a substring of "TestLifecycleRevocationSurvivesAControlPlaneRestart". These are the
  # ones this list exists for: the whole task is that `Revoke()` was implemented, tested, catalogued as
  # SAN-011's hard stop and CALLED BY NOTHING (§3.6 D15), so a security proof that reports the same green as
  # one that passes would be the identical failure one layer up.
  # What they run against a REAL Postgres, the REAL gateway on the REAL mTLS wire, and two real machines: a
  # revoked machine cannot reconnect to a SECOND gateway on the same CA and database (a control-plane
  # restart — `revoked` was an in-memory atomic.Bool, so a restart erased a revocation) while the machine
  # that was NOT revoked still takes a lease through it; a cordon survives the same restart with the machine
  # still CONNECTED and taking nothing, and a resume puts it back; a revoke is irreversible and journalled
  # exactly once however many times it is repeated, and another tenant cannot revoke the machine at all; and
  # the heartbeat advances `runners.last_seen_at` for a machine that has been parked doing nothing, which
  # before this froze the moment it finished connecting.
  #
  # THE FIVE E24 T2 NAMES ADDED BY T8's EXIT GATE, and they were found the way this list's comments keep
  # saying to find them: by RUNNING the selector and diffing `--- PASS` against the legs a gate claimed.
  # runner_pool_test.go is UNTAGGED, so these five ride `make verify` and were never missing from the tree —
  # what they were missing from was every -run allow-list, because not one of them starts with a word
  # already on this line. `TestPoolKey` does not match `TestAPoolServesItsWaitingRunsOldestFirst` and nothing
  # at all matches `TestAnUnsandboxedHostAttemptIsNeverOfferedToASandboxedLinuxRunner`. They hold the §2
  # invariant this whole epic is negotiated against — a wrong-pool machine is never offered an attempt, and
  # with no pool configured the behaviour is bit-for-bit today's — plus the chosen FIFO order, the pool whose
  # machine never comes, and the posture compared at the door. They need no Postgres, so running them in
  # this tier costs nothing and closes the gap between what a gate claims and what an invocation ran.
  #
  # TestHTTPToolApproval* is E23 T9 — the SLACK-LESS decision surface — and it needs its OWN alternative
  # for the third time this list has had to say so: `TestToolApproval` does not match
  # `TestHTTPToolApprovalListShows…` and neither does `TestSlackToolApproval`. Without this word, the eight
  # tests proving that a deployment with NO Slack workspace can see and answer a parked question at all
  # would report the same green as tests that pass. What they run over the SHIPPED router and a REAL spine:
  # GET /v1/approvals shows the parked call with its arguments verbatim and the operator's own
  # registration-time label (resolved through the same lookup the executor uses), an approve carrying the
  # bound request hash releases the run, a STALE hash and a MISSING hash decide nothing, another tenant's
  # key sees nothing and gets a non-disclosing 404, a key outside config_policy.approvers is refused on
  # both approve and deny while the listed one succeeds, a key without the `approve` capability decides
  # nothing, and a deny releases the run with the human's reason on the ledger.
  #
  # TestAConsoleWrittenEnvironment* is E25 T6 and it needs its OWN alternative for the reason this list keeps
  # discovering: nothing already on this line matches it. It is the one place in the tree where E25 T3's pipe
  # and T6's console meet — an environment, a repository binding, an agent, a revision naming that environment
  # and a run pinned to it are ALL created through PUBLIC HTTP routes on the shipped router (not one INSERT
  # below the tenant seed), and then a real `printenv` over the production host executor sees both keys. Its
  # sibling TestAnEnvironmentReachesARunsShellAndItsValueEntersNoDurableRow (E25 T3) proves the same pipe from
  # a hand-written revision row, which is exactly the step this one removes.
  if test "$status" -eq 0; then
    PALAI_COMPONENT_POSTGRES_URL="$url" \
      go test -tags=component -count=1 -v \
        -run 'TestApplied|TestRedelivery|TestPauseCheckpointCarriesBoundarySnapshot|TestPauseBoundaryCutsAndLinksSnapshotThroughOrchestrator|TestStuckWriterLeaseReclaimedAfterCrash|TestProvisioningInterruptedMidStateRecovers|TestPureToolReplay|TestIrreversibleUncertain|TestLateCallbackAfterFence|TestOutageCommandsDeliver|TestRecoveryProofCarries|TestStaleCommitOnReclaimer|TestDivergedContentReplay|TestPinnedRevision|TestBindingConnectionRef|TestProjectModelRoute|TestProviderErrorFailsTheModelStep|TestRemoteChild|TestBoundaryApproval|TestDispatchResolvesAnImageRefIntoTheProviderRequest|TestDispatchWithNoImageReaderMarksTheImageRatherThanFailing|TestClearSession|TestTheRealOrchestratorAdvertises|TestAnExternalToolIsAdvertised|TestARunReachesNoMCPServer|TestARegistryToolDispatchesThrough|TestToolsMemoryJourney|TestPublicationFromSlack|TestToolApproval|TestSlackToolApproval|TestExpiredToolApproval|TestApprover|TestAGatedMCPWrite|TestApprovedMCPArguments|TestAJiraTicketBodyCannotApproveItself|TestAToolPinnedTwiceRefuses|TestMergePullRequest|TestToolWithoutApprovalDeclared|TestHTTPToolApproval|TestBootstrapInstallEnrollsItsRunnerIntoTheDefaultPool|TestPoolKey|TestPlacement|TestLifecycle|TestStrict|TestAnUnsandboxedHostAttempt|TestASingleRunnerDeployment|TestAPoolServesItsWaitingRuns|TestDialRefusesAPool|TestAMachineDeclaringAPosture|TestAnEnvironmentReachesARunsShellAndItsValueEntersNoDurableRow|TestARunWhoseRevisionNamesAnEnvironmentFailsClosedWithNoResolver|TestARunsEnvironmentIsPinnedToItsRevisionNotToTheLatest|TestAConsoleWrittenEnvironment' \
        ./apps/control-plane/internal/execution
    status=$?
  fi
  # The E11 automation package drives against this same real spine: Task 1's agent-profile /
  # immutable-revision / template management + pin-resolution writes, and Task 4's webhook pump
  # fan-out -> signed real-HTTP delivery -> retry/dead-letter/redeliver state machine with real local
  # httptest receivers that verify the HMAC server-side (spec §21.4-21.6). Component-tagged.
  if test "$status" -eq 0; then
    PALAI_COMPONENT_POSTGRES_URL="$url" \
      go test -tags=component -count=1 -v ./apps/control-plane/internal/automation
    status=$?
  fi
  # The coordinator's admission pin-check (verifyPublishedRevision) has same-package component tests
  # that drive its query-error propagation against the real spine.
  if test "$status" -eq 0; then
    PALAI_COMPONENT_POSTGRES_URL="$url" \
      go test -tags=component -count=1 -v -run 'TestVerifyPublishedRevision|TestMigrationBoundedLockTimesOut' ./packages/coordinator
    status=$?
  fi
  # The E13 Task 2 tenancy provisioning store drives the real spine: second-tenant provisioning (MCI-001),
  # the config_policy resolver reachability (§14), strict-decode rejects, and cross-tenant key denial (RLS).
  if test "$status" -eq 0; then
    PALAI_COMPONENT_POSTGRES_URL="$url" \
      go test -tags=component -count=1 -v ./apps/control-plane/internal/identity
    status=$?
  fi
  # The E13 Task 6 metering store drives the real spine: the limit upsert's scope binding, the summary's
  # org/project narrowing, and the ledger keyset page (the SQL the fake-seam handler tests cannot reach).
  if test "$status" -eq 0; then
    PALAI_COMPONENT_POSTGRES_URL="$url" \
      go test -tags=component -count=1 -v ./apps/control-plane/internal/metering
    status=$?
  fi
  # The E14 Task 6 metrics collector drives the real spine: the installation-aggregate /metrics queries
  # run under the system-scope escape hatch across two seeded tenants, and the exposition carries the
  # summed counts but leaks no tenant id (the unauthenticated-surface guarantee).
  if test "$status" -eq 0; then
    PALAI_COMPONENT_POSTGRES_URL="$url" \
      go test -tags=component -count=1 -v ./apps/control-plane/internal/metrics
    status=$?
  fi
  # The E17 Task 4 knowledge spine drives this same real spine: immutable versioned ingestion + the
  # append-only REVOKE, ranked FTS retrieval with verifiable citation offsets, failed-refresh isolation
  # (KNO-002), source-delete propagation (KNO-004), and query-level tenant/ACL scoping (the KNO-003 hook).
  if test "$status" -eq 0; then
    PALAI_COMPONENT_POSTGRES_URL="$url" \
      go test -tags=component -count=1 -v ./apps/control-plane/internal/knowledge
    status=$?
  fi
  # The E17 Task 2 A2A wiring drives this same real spine: an A2A message:send through the production
  # WithA2A Admitter (NewA2AServer's a2aRuns over store.Store) births a genuine run under the auth scope
  # and resolves through the real GetResponse — the real-Admitter admission the review requires. The E19
  # Task 1 Slack Events route joins it: the SHIPPED POST /v1/slack/events, over the production router and
  # the same real Admitter, against a fake Slack peer built to the published contract (one run per source
  # event through a retry storm, one session per thread, bot-self births nothing, and a rejected delivery
  # writes nothing at all).
  #
  # The RETURN LEG joins them: what lands in responses.input is the human's message (not the envelope the
  # model used to describe back), and a run driven terminal through the REAL coordinator answers in its
  # thread exactly once -- through repeated ticks, a re-driven terminal transition, a permanently
  # rate-limited Slack, and a disabled connection. TestSlack* already selects all of it.
  #
  # TestAgentSurfaceJourney is named EXPLICITLY and that is not decoration: this -run list is an allow-list,
  # so a test whose name it does not match is a test this tier never runs. The E20 journey does not begin
  # with "TestSlack", so without this alternation it would have ridden `make test-component` reporting
  # nothing at all — this repository's signature failure, eleven findings deep.
  if test "$status" -eq 0; then
    PALAI_COMPONENT_POSTGRES_URL="$url" \
      go test -tags=component -count=1 -v -run 'TestA2ARealAdmitterBirthsRun|TestSlack|TestAgentSurfaceJourney' ./apps/control-plane/internal/store
    status=$?
  fi
  # The E24 T1 runner registry against a REAL Postgres with RLS enforced (apps/control-plane/internal/fleet
  # is an internal package, so its component tests cannot live under tests/). It has its OWN leg rather
  # than a name on a -run list because the package has no other tests: two machines sharing the compose
  # default label are two rows with two SERVER-minted ids, an unknown pool REFUSES instead of writing a
  # dangling reference, the enrolment journal entry commits with the row it describes, a pre-registry
  # runner's certificate is found=false rather than an error (or an upgraded stack would refuse its own
  # runner), and neither tenant can read or address the other's machines.
  if test "$status" -eq 0; then
    PALAI_COMPONENT_POSTGRES_URL="$url" \
      go test -tags=component -count=1 -v ./apps/control-plane/internal/fleet
    status=$?
  fi
  # The E19 last mile: the three *_ref handles a `palai up` registration writes on a REAL
  # slack_connections row redeem to the values stored through the E13 T3 secret store, and each is
  # read off its REAL consumer — a v0 MAC computed longhand, and the two Authorization headers a
  # fake Slack sees on chat.update and apps.connections.open. Before it, `palai up` registered
  # handles that resolved NOWHERE and every consumer failed silently by design. The companion
  # asserts the loop refuses to dial at all on an unredeemable handle.
  if test "$status" -eq 0; then
    PALAI_COMPONENT_POSTGRES_URL="$url" \
      go test -tags=component -count=1 -v \
        -run 'TestSlackHandlesRedeemToTheStoredValues|TestSlackSocketRefusesToDialOnAnUnredeemableHandle' \
        ./apps/control-plane/internal/extensions
    status=$?
  fi
  set -e
  if test "$status" -ne 0; then
    docker logs "$container" >&2 || true
  fi

  cleanup
  trap - EXIT
  local containers_after volumes_after
  containers_after="$(count_containers)"
  volumes_after="$(count_volumes)"
  if test "$containers_after" -ne "$containers_before" || test "$volumes_after" -ne "$volumes_before"; then
    echo "postgres component suite leaked a container or volume" >&2
    exit 1
  fi
  if test "$status" -ne 0; then
    exit "$status"
  fi
  echo "component_postgres=PASS containers=$containers_after volumes=$volumes_after"
}

# The artifacts suite proves the S3 write-path (spec §22.6, LP §7.2 object-store carve-out)
# against a real SeaweedFS plus a real Postgres for the index rows: an artifact PUT records a
# row + object + checksum, a read is tenant-scoped, and the store:false retention purge deletes
# the artifact bytes. Both throwaway containers share one label so the leak check counts them.
run_artifacts() {
  local pg_image="postgres@sha256:17e67d7b9890c99b055ba1e0d5c5be4ec27c9d3a72bda32db24a5e5d8a85af0c"
  # SeaweedFS digest matches ADR-0004 / deploy/compose/compose.yaml (doctor pins the same).
  local s3_image="docker.io/chrislusf/seaweedfs@sha256:c7d6c721b30ae711db766bbbfd40192776e263d4e51e22f57baef7bef93c12c6"
  local label="io.palai.component=artifacts"
