# The queue suite proves the E17 T7 queue adapter (spec §34.1-34.5) against a real Postgres: the durable
# reference queue's crash-before-ack redelivery + append-only-idempotency dedupe, flood backpressure,
# poison dead-letter, and the outbound outbox's loss-less exactly-once delivery — plus migration 000037's
# idempotency + the effect-ledger's append-only REVOKE across reboots. No real broker (SQS/PubSub/Kafka is
# the operator leg); durability is deterministic (a forced lease-expiry). It reuses the throwaway-postgres
# idiom (the run_postgres pattern) with its own label so the leak check counts only its container.
run_queue() {
  local image="postgres@sha256:17e67d7b9890c99b055ba1e0d5c5be4ec27c9d3a72bda32db24a5e5d8a85af0c"
  local label="io.palai.component=queue"
  local run_id="$$-${RANDOM}"
  local container="palai-e17t7-queue-$run_id"
  local volume="palai-e17t7-queue-$run_id"
  local password="palai-component-${RANDOM}${RANDOM}"

  count_containers() { docker ps -aq --filter "label=$label" | sed '/^$/d' | wc -l | tr -d ' '; }
  count_volumes() { docker volume ls -q --filter "label=$label" | sed '/^$/d' | wc -l | tr -d ' '; }
  cleanup() {
    docker rm -f "$container" >/dev/null 2>&1 || true
    docker volume rm -f "$volume" >/dev/null 2>&1 || true
  }
  local containers_before volumes_before
  containers_before="$(count_containers)"
  volumes_before="$(count_volumes)"
  trap cleanup EXIT

  docker volume create --label "$label" "$volume" >/dev/null
  docker run --detach --pull=never --name "$container" --label "$label" \
    --env POSTGRES_DB=palai --env POSTGRES_PASSWORD="$password" \
    --publish 127.0.0.1::5432 --volume "$volume:/var/lib/postgresql/data" "$image" >/dev/null
  local ready=0
  for _ in $(seq 1 120); do
    if docker exec "$container" pg_isready --username postgres --dbname palai >/dev/null 2>&1; then ready=1; break; fi
    sleep 0.25
  done
  if test "$ready" -ne 1; then docker logs "$container" >&2 || true; echo "postgres queue container did not become ready" >&2; exit 1; fi
  local binding port url
  binding="$(docker port "$container" 5432/tcp)"
  port="${binding##*:}"
  url="postgres://postgres:$password@127.0.0.1:$port/palai?sslmode=disable"

  set +e
  # The queue adapter durability + contract proofs (automation package, component-tagged).
  PALAI_COMPONENT_POSTGRES_URL="$url" \
    go test -tags=component -count=1 -v -run 'TestQueueAdapter|TestQueueOutbox' ./apps/control-plane/internal/automation
  local status=$?
  # Migration 000037 idempotency, the enqueue-dedupe unique, and the effect-ledger append-only REVOKE.
  if test "$status" -eq 0; then
    PALAI_COMPONENT_POSTGRES_URL="$url" \
      go test -tags=component -count=1 -v -run 'TestMigration37Queues' ./tests/component/postgres
    status=$?
  fi
  set -e
  if test "$status" -ne 0; then docker logs "$container" >&2 || true; fi

  cleanup
  trap - EXIT
  local containers_after volumes_after
  containers_after="$(count_containers)"
  volumes_after="$(count_volumes)"
  if test "$containers_after" -ne "$containers_before" || test "$volumes_after" -ne "$volumes_before"; then
    echo "queue component suite leaked a container or volume" >&2
    exit 1
  fi
  if test "$status" -ne 0; then exit "$status"; fi
  echo "component_queue=PASS containers=$containers_after volumes=$volumes_after"
}

# The packaged suite proves the outside-the-tree bring-up: a `palai` binary whose working directory
# has no deploy/ above it brings up a real stack and every doctor check goes green.
#
# It builds the three images HERE because nothing is published — release.yml's publish step is the
# credential-less dry run (plan §6 leg 2) — so a packaged bring-up can only be driven with locally
# built ones. They are built SERIALLY and for the host platform only: no buildx, no --platform, no
# emulation. The Dockerfile paths and contexts are compose.yaml's own (context ../.. from
# deploy/compose is this repo root).
#
# The engine tag is handed to the test as a TAG, not a digest. That is deliberate: resolving it to
# the bare sha256 config digest the runner's lease requires is part of what the packaged path does,
# and passing a digest here would test around it.
run_packaged() {
  docker build -q -f deploy/compose/control-plane.Dockerfile -t palai/control-plane:local . >/dev/null
  docker build -q -f deploy/compose/runner.Dockerfile -t palai/runner:local . >/dev/null
  docker build -q -t palai/reference-engine:local engines/reference >/dev/null

  # -run names the test EXPLICITLY, and the name below is the allow-list: a bring-up proof this
  # list does not name is a proof that never runs.
  PALAI_PACKAGED_IMAGES="palai/control-plane:local,palai/runner:local,palai/reference-engine:local" \
    go test -tags=component -count=1 -v \
      -run 'TestPackagedStackComesUpOutsideTheTree' ./cmd/cli
  echo "component_packaged=PASS"
}

# The native-shell suite is the ONE component suite that needs no Docker and no Postgres, and that is
# the measurement it exists to carry (E22 T1): a Mac deployment runs the control plane NATIVELY, so
# the proof that the agent reaches the host's own toolchain must not itself require a container.
#
# -run names the tests EXPLICITLY, and the list below is the allow-list: a proof this list does not
# name is a proof that never runs, and this tier has shipped green-by-omission before.
run_native_shell() {
  go test -tags=component -count=1 -v \
    -run 'TestNativeShellPostureRunsTheHostsOwnToolchain|TestNativeShellPostureSeparatesConcurrentSessionsOnOneMac|TestShellToolStillFailsCleanlyWithNoPostureConfigured|TestAnEnvironmentValueReachesTheAgentsShellAndTheHostsDoesNot|TestAnEnvironmentKeyCannotShadowTheSandboxsOwnPATH' \
    ./apps/control-plane/internal/execution/tools
  # The host executor's own guards (environment allow-list, ReadOnly refusal, process-group kill) are
  # untagged and ride `make verify`; they are re-run here because this suite is what a Mac operator
  # runs before trusting the posture.
  go test -count=1 -v ./adapters/sandboxes/host
  # The DEPLOYMENT half (E22 T5): the three facts native-control-plane.yml states in prose, refused by
  # name before any Docker work, and the teardown that stops the native process instead of orphaning
  # it. Same allow-list discipline — a guard this -run does not name is a guard this tier never runs.
  go test -count=1 -v \
    -run 'TestNativeRunnerListener|TestNativeWorkspaceRoot|TestNativeEnvironment|TestNativeStop' \
    ./cmd/cli/internal/stack
  echo "component_native_shell=PASS"
}

case "$suite" in
  postgres) run_postgres ;;
  packaged) run_packaged ;;
  queue) run_queue ;;
  runner) run_runner ;;
  artifacts) run_artifacts ;;
  repository) run_repository ;;
  remote-tools) run_remote_tools ;;
  tool-sdk) run_tool_sdk ;;
  mcp) run_mcp ;;
  skills) run_skills ;;
  hooks) run_hooks ;;
  native-shell) run_native_shell ;;
  *)
    echo "unknown component suite: $suite (known: postgres, packaged, queue, runner, artifacts, repository, remote-tools, tool-sdk, mcp, skills, hooks, native-shell)" >&2
    exit 2
    ;;
esac
