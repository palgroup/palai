# Palai agent host env. Install to /etc/palai/runner.env and edit.
#
# ‼️ THIS FILE IS THE COMPOSE/SYSTEMD PATH, NOT THE DEVICE PATH, and the difference is the whole of the
# device plan. A machine that joins a fleet runs ONE command, once:
#
#     curl -fsSL https://releases.palai.dev/install.sh | sh
#     palai enroll --url https://<runner gateway> --key-file /secure/path/pool-key
#
# `enroll` writes the config and the durable device identity, installs the service, and returns. Nothing
# below is typed on that machine, because nothing below is an answer the machine cannot work out for
# itself: the pool key names the pool, the binary measures the OS, the architecture and what it can
# isolate a session with, and the admin plane sets the concurrency.
#
# What remains here is for a deployment that ALREADY runs this way — a Compose stack or a systemd unit an
# operator owns and edits. Those keep their reader for one release (device plan 3.7); a packaged agent
# never had one.
#
# ‼️ THE PER-MACHINE IDENTITY FIELDS ARE GONE AND WERE NOT MOVED. PALAI_RUNNER_ID and PALAI_RUNNER_DNS
# used to be edited on every box. A client-supplied id is exactly the trust the device design removes:
# identity is now a keypair the machine generates on first start and proves with a signed CSR, so the
# same machine comes back as the same machine after a reboot without anybody naming it. Setting them
# here would not restore that — it would name a machine the registry keys by fingerprint anyway.
#
# Secrets are FILES, never values in this file.

# The control-plane's runner-gateway URL (mTLS). Reachable from THIS host; a two-VM deploy firewalls it
# to the runner subnet. Everything else — enrolment, session, renewal, settings — is derived from it.
PALAI_CONTROLLER_URL=https://controller.example.internal:8443

# The controller CA this host trusts — copy from the control-plane host's ${PALAI_HOME}/ca/ca.crt.
# OMIT IT ENTIRELY for a gateway with a publicly trusted certificate: unset means the host's own root
# store verifies the server, which is the normal case rather than a degraded one.
PALAI_CONTROLLER_CA=/etc/palai/runner/ca.crt

# Pool enrolment key FILE (rpk_...), minted in the console or with `palai admin`. It is scoped to ONE
# pool, reusable across machines, and revocable — revoking it refuses new enrolments while machines
# already enrolled keep renewing on their own certificates.
PALAI_ENROLLMENT_TOKEN_FILE=/etc/palai/runner/pool-key

# The reference engine image this host launches per lease. It must be pullable or pre-loaded HERE: the
# agent drives the local Docker socket to launch the engine sandbox.
PALAI_ENGINE_IMAGE=palai/reference-engine:local

# Concurrent lease slots. The admin plane's desired document overrides it the moment this machine polls,
# so this is the value it serves until its first answer — not the final one.
PALAI_RUNNER_CONCURRENCY=1
