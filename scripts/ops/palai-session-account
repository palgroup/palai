#!/usr/bin/env bash
# THE PRIVILEGED SURFACE, AND IT IS DELIBERATELY TINY: two verbs, one argument, no pass-through.
#
# WHY IT EXISTS. A session on a Mac is isolated by its uid and by nothing else — `xcrun simctl spawn`
# defeats every weaker mechanism on this platform (docs/research/macos-isolation-without-accounts.md, T14
# and T17). So a session needs an account created when it starts and destroyed when it ends, and the
# control plane must be able to do that WITHOUT an operator typing a password each time. That means one
# entry in sudoers, and the whole security question becomes: what can be reached through that entry.
#
# WHY NOT PUT mac-sessions.sh IN SUDOERS DIRECTLY. Because a NOPASSWD line naming a script that takes
# `--count`, `--mode` and `--apply` grants everything that script can do, forever, to whoever can run it.
# `down --mode accounts --apply` deletes every session account on the box. A sudoers entry is not a
# suggestion — it is the shape of the privilege, so the shape has to be the thing that is safe.
#
# WHAT THIS ACCEPTS is one verb and one two-digit session index, validated here BEFORE anything with
# authority runs. Nothing else reaches mac-sessions.sh: no flags, no counts, no mode. `create` cannot
# delete and `destroy` cannot be aimed at anything but one index this script itself formats.
#
# WHAT IT DOES NOT DO is decide whether a deletion is permitted. That answer stays where it already lives
# and where its table of cases is exercised — `deletion_is_permitted` in mac-sessions.sh, which requires
# the name pattern, the uid this tooling would have allocated, AND a marker written into the record by
# root and minted on THIS Mac. This wrapper narrows what can be ASKED; it does not widen what is allowed.
#
# Usage (the only two forms that exist):
#   palai-session-account create  <index>
#   palai-session-account destroy <index>
#
# Install the sudoers entry with `install-sudoers` — printed rather than written, because a file that
# grants passwordless root is one an operator reads before it exists.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
mac_sessions="$here/mac-sessions.sh"

die() {
	printf 'palai-session-account: %s\n' "$*" >&2
	exit 2
}

usage() {
	printf 'usage: %s {create|destroy} <index 01..99>\n' "$(basename "$0")" >&2
	printf '       %s install-sudoers <runas-user>\n' "$(basename "$0")" >&2
	exit 2
}

# validate_index is the whole attack surface, so it refuses rather than repairs and it refuses on SHAPE
# rather than on a range check applied to whatever arithmetic made of the string. "1", "+1", " 1", "01 ",
# "1e1" and "0x11" are all things $((...)) will happily turn into a number; none of them are what this
# tooling formats, and a value that took a different path to the same integer took a path nobody tested.
validate_index() {
	case "$1" in
	0[1-9] | [1-9][0-9]) ;;
	*) die "index must be exactly two digits, 01..99 (got $(printf '%q' "$1"))" ;;
	esac
}

case "${1:-}" in
create)
	[ $# -eq 2 ] || usage
	validate_index "$2"
	# --count "$2" creates sessions 1..N, not session N. A wrapper that reached for it would create every
	# lower-numbered account as a side effect of asking for one, which is why the index is passed as an
	# explicit single-session selector instead.
	exec bash "$mac_sessions" up --mode accounts --only "$2" --apply
	;;
destroy)
	[ $# -eq 2 ] || usage
	validate_index "$2"
	exec bash "$mac_sessions" down --mode accounts --only "$2" --apply
	;;
install-sudoers)
	[ $# -eq 2 ] || usage
	runas="$2"
	case "$runas" in
	*[!a-zA-Z0-9._-]* | "") die "runas user must be a plain account name (got $(printf '%q' "$runas"))" ;;
	esac
	# PRINTED, NOT WRITTEN. A file that grants passwordless root is one an operator reads first, and a
	# script that writes it silently is a script that installed a privilege nobody reviewed. The path is
	# named so the reader knows exactly what to create and where.
	cat <<EOF
# Write this to /etc/sudoers.d/palai-session-account (mode 0440, root:wheel) and validate it with
# \`visudo -cf /etc/sudoers.d/palai-session-account\` BEFORE trusting it. It grants $runas the right to run
# exactly this wrapper as root with no password — and the wrapper accepts one verb and one two-digit
# index, so that is the entire privilege being granted.
$runas ALL=(root) NOPASSWD: $here/palai-session-account create [0-9][0-9], $here/palai-session-account destroy [0-9][0-9]
EOF
	;;
*) usage ;;
esac
