#!/usr/bin/env bash
# THE LIVE SMOKE FOR THE iOS DEMO CHAIN. It proves the product rather than the suite.
#
# WHY IT EXISTS, stated plainly: every piece of this chain had unit tests and a green suite, and NONE of
# that is evidence that a person can point the demo at a repository and watch an agent change code and
# show them the result. A green suite says each part behaves as its author expected in isolation. This
# says the parts reach each other on a real machine.
#
# EVERY LEG PRINTS ITS EVIDENCE, and a leg that cannot run says UNPROVEN rather than passing. That
# distinction is the whole point: "the account leg did not run because no sudoers entry is installed" and
# "the account leg passed" are different sentences, and a smoke that blurs them is worse than none —
# it converts a missing capability into a green line.
#
# Usage:
#   scripts/live/ios-demo-smoke                       # everything that needs no privilege
#   scripts/live/ios-demo-smoke --with-build          # additionally builds the app and shows a screenshot
#   scripts/live/ios-demo-smoke --with-accounts       # additionally proves the per-session uid
#
# --with-accounts needs palai-agentd installed on this Mac. It is ONE command, run once, and it needs
# no sudoers entry — the daemon exists so that nothing has to be argued into running as root:
#   sudo palai agentd install
set -uo pipefail

API="${PALAI_BASE_URL:-http://127.0.0.1:60351}"
KEY="${PALAI_API_KEY:-$(cat "${PALAI_HOME:-.palai}/api-key" 2>/dev/null || true)}"
# A REAL, PUBLIC iOS APP — chosen so the clone leg proves a clone rather than a fixture. Measured
# 2026-08-02 with `HOME=/nonexistent GIT_TERMINAL_PROMPT=0`, which is the only honest way to check it:
# an earlier measurement of a different repo "succeeded" using THIS machine's gh credential, which the
# control plane does not have and must never have. 224 KiB, a SwiftUI todo list, one .xcodeproj.
REPO_URL="${SMOKE_REPO_URL:-https://github.com/fredrik9000/TodoList_SwiftUI.git}"
WITH_ACCOUNTS=0
WITH_BUILD=0
# One nonce per invocation, so two runs of this file never present each other's idempotency keys.
SMOKE_RUN="$(date +%s)$$"
for arg in "$@"; do
	case "$arg" in
	--with-accounts) WITH_ACCOUNTS=1 ;;
	--with-build) WITH_BUILD=1 ;;
	esac
done

pass=0
fail=0
unproven=0

say() { printf '%s\n' "$*"; }
hdr() { printf '\n== %s ==\n' "$*"; }
# EVIDENCE IS PRINTED WITH EVERY VERDICT. A PASS with no evidence is an assertion, and this file exists
# because assertions were what we had.
ok() {
	pass=$((pass + 1))
	printf '  [PASS     ] %-46s %s\n' "$1" "${2:-}"
}
no() {
	fail=$((fail + 1))
	printf '  [FAIL     ] %-46s %s\n' "$1" "${2:-}"
}
skip() {
	unproven=$((unproven + 1))
	printf '  [UNPROVEN ] %-46s %s\n' "$1" "${2:-}"
}

# THE KEY COMES FROM /dev/urandom, AND THE TWO THINGS THAT DID NOT WORK ARE WHY.
#
# Every call here runs inside a command substitution, which is a SUBSHELL, and that fact defeats both
# obvious answers. `$RANDOM` replays: a subshell inherits the RNG state, so each one produces the same
# sequence — six POSTs in a loop, five rejected `idempotency_mismatch`. A monotonic `_seq=$((_seq+1))`
# is worse, because it looks like the fix: the increment happens in the subshell and never reaches the
# parent, so every call is number one again. That one survived a green run and only surfaced on the
# SECOND POST to a path, since a key collides only when it is reused with a different body.
#
# /dev/urandom is read fresh inside the subshell, so it has no parent state to inherit or fail to write
# back. A smoke whose own keys collide reports the product failing and points the reader at the wrong
# file — which is the failure this tree pays for over and over.
api() {
	local method="$1" path="$2" body="${3:-}"
	local nonce
	nonce="$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')"
	if [ -n "$body" ]; then
		curl -sS -X "$method" "$API$path" -H "Authorization: Bearer $KEY" \
			-H 'content-type: application/json' -H "Idempotency-Key: smoke-$SMOKE_RUN-$nonce" -d "$body"
	else
		curl -sS -X "$method" "$API$path" -H "Authorization: Bearer $KEY"
	fi
}
jq_get() { python3 -c "import sys,json;d=json.load(sys.stdin);print(d$1 if d else '')" 2>/dev/null || true; }

test -n "$KEY" || {
	say "no API key: set PALAI_API_KEY or run from a tree with .palai/api-key"
	exit 2
}

hdr "0. THE STACK ANSWERS"
caps="$(api GET /v1/capabilities)"
if printf '%s' "$caps" | grep -q '"responses"'; then
	ok "control plane serves /v1/capabilities" "$API"
else
	no "control plane serves /v1/capabilities" "$API answered: $(printf '%s' "$caps" | head -c 120)"
	say "nothing below can run against a stack that is not up"
	exit 1
fi

hdr "1. A REAL REPOSITORY, CLONED BY THE CONTROL PLANE"
# The binding is what a run is pointed at; the clone happens inside provisionFreshAllocation when the
# run mints its workspace. So a binding that CREATES is not yet evidence of a clone — the evidence is
# the repository's own files being readable by a tool, which leg 4 asserts.
binding="$(api POST /v1/repository-bindings "{\"provider\":\"github\",\"repository_identity\":\"fredrik9000/TodoList_SwiftUI\",\"clone_url\":\"$REPO_URL\"}")"
binding_id="$(printf '%s' "$binding" | jq_get "['id']")"
if [ -n "$binding_id" ]; then
	ok "repository binding created" "$binding_id -> $REPO_URL"
else
	no "repository binding created" "$(printf '%s' "$binding" | head -c 200)"
fi

hdr "2. THE iOS AGENT, PUBLISHED"
agent="$(api POST /v1/agents "{\"name\":\"ios-smoke-$(date +%s)\"}")"
agent_id="$(printf '%s' "$agent" | jq_get "['id']")"
rev=""
if [ -n "$agent_id" ]; then
	# NO `model` FIELD, AND THAT IS THE POINT. A revision that names one OVERRIDES the deployment's route,
	# and a name the configured provider does not recognise comes back as a bare HTTP 404. Measured
	# 2026-08-02: this file pinned "gpt-4o-mini" against an Anthropic-routed deployment; the engine parked
	# at `safe_boundary before_model, step 1` and exited 0 without ever calling the model, the runner
	# re-leased the run five times, and the whole record was `run.failed.v1 {state, run_id}` with an empty
	# control-plane log. Four minutes of `in_progress`, and a smoke that read it as the CHAIN being broken.
	#
	# Leaving it out is also what `palai up` does for the Slack profile, and for the same reason: the
	# deployment's operator chose the model, and an agent definition that silently re-chooses it is a
	# second opinion nobody asked for.
	rev="$(api POST "/v1/agents/$agent_id/revisions" '{
    "instructions":"You are an iOS engineer in a cloned repository. Read before you edit. After a visible change take a screenshot and SHOW it with palai.workspace.show_media, then ask whether it looks right.",
    "tools":["palai.workspace.file","palai.workspace.shell","palai.workspace.show_media"]
  }' | jq_get "['id']")"
fi
if [ -n "$rev" ]; then
	published="$(api POST "/v1/agents/$agent_id/revisions/$rev/publish" | jq_get "['status']")"
	if [ "$published" = "published" ]; then
		# A DRAFT IS NOT AN AGENT. Publishing is what makes a run get the config, so the verdict is the
		# publish rather than the create — an earlier version of this file stopped at the 201.
		ok "agent published with rules and tools" "$agent_id rev=$rev"
	else
		no "agent published with rules and tools" "publish answered: $published"
	fi
else
	no "agent revision created" "$(printf '%s' "$agent" | head -c 200)"
fi

hdr "3. A SESSION, AND THE uid IT RUNS AS"
before_accounts="$(dscl . -list /Users 2>/dev/null | grep -c '^palai-s' || true)"
session="$(api POST /v1/sessions '{"name":"ios-demo-smoke"}')"
session_id="$(printf '%s' "$session" | jq_get "['id']")"
if [ -n "$session_id" ]; then
	ok "session created" "$session_id"
else
	no "session created" "$(printf '%s' "$session" | head -c 200)"
	exit 1
fi

hdr "4. THE RUN: read the CLONE, change code, build, screenshot, SHOW it"
prompt='List the Swift files in the repository, then read one of them and tell me what it does. Do not change anything yet.'
resp="$(api POST /v1/responses "{
  \"session_id\": \"$session_id\",
  $([ -n "$agent_id" ] && printf '"agent_id": "%s",' "$agent_id")
  $([ -n "$binding_id" ] && printf '"repository": {"binding_id": "%s"},' "$binding_id")
  \"input\": $(python3 -c "import json,sys;print(json.dumps(sys.argv[1]))" "$prompt"),
  \"background\": true
}")"
response_id="$(printf '%s' "$resp" | jq_get "['id']")"
if [ -n "$response_id" ]; then
	ok "response accepted" "$response_id"
else
	no "response accepted" "$(printf '%s' "$resp" | head -c 300)"
fi

# WAIT ON THE JOURNAL, NOT ON A TIMER. A fixed sleep is how a smoke reports a pass for a run that had not
# started; the terminal event is the fact.
deadline=$((SECONDS + 240))
state=""
while [ $SECONDS -lt $deadline ]; do
	state="$(api GET "/v1/responses/$response_id" | jq_get "['status']")"
	case "$state" in
	completed | failed | canceled | timed_out | budget_exceeded) break ;;
	esac
	sleep 3
done
if [ "$state" = "completed" ]; then
	ok "run reached a terminal state" "$state"
else
	no "run reached a terminal state" "stopped at: ${state:-<none>} after $((240 - (deadline - SECONDS)))s"
fi

hdr "5. WHAT THE RUN ACTUALLY DID (the ledger, not the summary)"
calls="$(api GET "/v1/responses/$response_id/tool-calls")"
names="$(printf '%s' "$calls" | python3 -c "
import sys,json
try: rows=json.load(sys.stdin).get('data') or []
except Exception: rows=[]
print(' '.join(sorted({r.get('name','') for r in rows if r.get('name')})))" 2>/dev/null)"
if [ -n "$names" ]; then
	ok "tools were actually called" "$names"
else
	no "tools were actually called" "the ledger read returned none"
fi
# THE CLONE'S EVIDENCE IS A TOOL SEEING THE REPOSITORY'S OWN FILES. A binding row proves a row.
cloned="$(printf '%s' "$calls" | python3 -c "
import sys,json
try: rows=json.load(sys.stdin).get('data') or []
except Exception: rows=[]
blob=json.dumps(rows)
print('yes' if '.swift' in blob or 'Package.swift' in blob or '.xcodeproj' in blob else 'no')" 2>/dev/null)"
if [ "$cloned" = "yes" ]; then
	ok "the repository was really cloned" "a tool saw the repo's own files"
else
	no "the repository was really cloned" "no tool call mentions a Swift/Xcode path"
fi
shown="$(printf '%s' "$calls" | grep -c 'show_media' || true)"
if [ "${shown:-0}" -gt 0 ]; then
	ok "the agent SHOWED media" "$shown show_media call(s)"
else
	skip "the agent SHOWED media" "this prompt did not ask for a visible change; leg 7 drives that"
fi

hdr "6. THE WHOLE POINT: build it, run it in a simulator, SHOW the human"
# THIS LEG IS THE PRODUCT. Everything above proves plumbing; this proves the sentence the owner
# actually asked for — "change the code, build it, run it in the simulator, and show me a screenshot so
# I can say whether I like it".
#
# IT IS OPT-IN because it drives a real xcodebuild against a real simulator: minutes, not seconds, and
# a machine with no Xcode cannot run it at all. An UNPROVEN line says which of those it was.
if [ "$WITH_BUILD" -eq 1 ]; then
	build_prompt='Boot an iOS simulator, build this SwiftUI app for it with xcodebuild, install and launch it, then take a screenshot with `xcrun simctl io booted screenshot shot.png` and SHOW it to me with palai.workspace.show_media. Work step by step.'
	bresp="$(api POST /v1/responses "{
    \"session_id\": \"$session_id\",
    $([ -n "$agent_id" ] && printf '"agent_id": "%s",' "$agent_id")
    $([ -n "$binding_id" ] && printf '"repository": {"binding_id": "%s"},' "$binding_id")
    \"input\": $(python3 -c "import json,sys;print(json.dumps(sys.argv[1]))" "$build_prompt"),
    \"background\": true
  }")"
	bid="$(printf '%s' "$bresp" | jq_get "['id']")"
	bstate=""
	[ -n "$bid" ] || say "        the build response was NOT accepted: $(printf '%s' "$bresp" | head -c 220)"
	if [ -n "$bid" ]; then
		# A REAL BUILD DEADLINE. The first xcodebuild on a cold machine compiles a whole SwiftUI target and
		# boots a simulator; 240s is a timeout, not a measurement.
		bdeadline=$((SECONDS + 900))
		while [ $SECONDS -lt $bdeadline ]; do
			bstate="$(api GET "/v1/responses/$bid" | jq_get "['status']")"
			case "$bstate" in
			completed | failed | canceled | timed_out | budget_exceeded) break ;;
			esac
			sleep 5
		done
	fi
	bcalls="$(api GET "/v1/responses/$bid/tool-calls")"
	# THE EVIDENCE IS THE ARTIFACT'S BYTES, NOT THE CALL. A show_media call that answered with an id
	# proves the model asked; fetching the object and reading a PNG header proves a picture exists. An
	# earlier version of this file stopped at the call, which is the same mistake as trusting a terminal
	# status over the ledger.
	art="$(printf '%s' "$bcalls" | python3 -c "
import sys,json
rows=json.load(sys.stdin).get('data') or []
for r in rows:
    if (r.get('name') or '').endswith('show_media'):
        res = r.get('result') or {}
        if isinstance(res,str):
            try: res=json.loads(res)
            except Exception: res={}
        print(res.get('artifact_id') or '')
        break" 2>/dev/null)"
	built="$(printf '%s' "$bcalls" | grep -c 'xcodebuild' || true)"
	if [ "${built:-0}" -gt 0 ]; then
		ok "the agent BUILT the app it cloned" "$built xcodebuild call(s)"
	else
		no "the agent BUILT the app it cloned" "no xcodebuild in the ledger (run state: ${bstate:-<none>})"
	fi
	if [ -n "$art" ]; then
		hdr_bytes="$(curl -sS "$API/v1/artifacts/$art/content" -H "Authorization: Bearer $KEY" |
			python3 -c "
import sys
d=sys.stdin.buffer.read()
print('png' if d[:8]==b'\x89PNG\r\n\x1a\n' else 'not-png', len(d))" 2>/dev/null)"
		case "$hdr_bytes" in
		png*) ok "the agent SHOWED a real screenshot" "$art — $hdr_bytes bytes of PNG" ;;
		*) no "the agent SHOWED a real screenshot" "$art fetched as: ${hdr_bytes:-<nothing>}" ;;
		esac
	else
		no "the agent SHOWED a real screenshot" "no show_media call in the ledger (run state: ${bstate:-<none>})"
	fi
else
	skip "the agent BUILT the app it cloned" "run with --with-build (a real xcodebuild, minutes)"
	skip "the agent SHOWED a real screenshot" "run with --with-build"
fi

hdr "7. THE SESSION'S OWN uid"
# ‼️ THIS SECTION USED TO COUNT ACCOUNTS AND CALL THAT THE uid. It compared `dscl . -list /Users | grep -c
# '^palai-s'` before and after, which proves the control plane REACHED the wrapper — a real thing, and not
# the boundary. "An account was created" and "the command ran as it" are two claims, and only the second is
# what isolates one customer's session from another's. The count is still taken (it is what fails loudly
# when the sudoers entry is missing), and the uid is now MEASURED through the session's own shell tool.
uid_name=""
uid_probe="$(api POST /v1/responses "{
  \"session_id\": \"$session_id\",
  $([ -n "$binding_id" ] && printf '"repository": {"binding_id": "%s"},' "$binding_id")
  \"input\": \"Run exactly this shell command and nothing else: id -un\",
  \"background\": true
}")"
uid_resp="$(printf '%s' "$uid_probe" | jq_get "['id']")"
if [ -n "$uid_resp" ]; then
	uid_deadline=$((SECONDS + 180))
	while [ $SECONDS -lt $uid_deadline ]; do
		case "$(api GET "/v1/responses/$uid_resp" | jq_get "['status']")" in
		completed | failed | canceled | timed_out | budget_exceeded) break ;;
		esac
		sleep 3
	done
	# THE LEDGER, NOT THE PROSE. The model's summary is free to paraphrase; the tool call's own stdout is
	# what the machine actually printed.
	uid_name="$(api GET "/v1/responses/$uid_resp/tool-calls" | python3 -c "
import sys,json
try: rows=json.load(sys.stdin).get('data') or []
except Exception: rows=[]
for r in rows:
    if r.get('name') != 'palai.workspace.shell':
        continue
    out=((r.get('result') or {}).get('stdout') or '').strip()
    if out:
        print(out.splitlines()[-1].strip()); break" 2>/dev/null)"
fi

if [ -z "$uid_name" ]; then
	no "the session's commands ran as a measurable account" "the shell tool returned no stdout; without it this section is counting accounts and calling it a boundary"
elif [ "$WITH_ACCOUNTS" -eq 1 ]; then
	case "$uid_name" in
	palai-s*) ok "the session's commands ran as its OWN account" "$uid_name" ;;
	*) no "the session's commands ran as its OWN account" "ran as $uid_name — an account may exist, but the run is not inside it" ;;
	esac
else
	# THE HONEST REPORT OF AN UNWIRED DEPLOYMENT, and it is a measurement rather than a skip: the uid a
	# command runs as is a fact this smoke can take on any stack, and naming it is what stops "no accounts
	# configured" from reading like "not checked".
	skip "the session's commands ran as its OWN account" "ran as $uid_name — this deployment mints none, so a session's commands run as the control plane's own uid, which docs/operations/palai-on-a-mac.md §7 is explicit is NOT a boundary"
fi

if [ "$WITH_ACCOUNTS" -eq 1 ]; then
	after_accounts="$(dscl . -list /Users 2>/dev/null | grep -c '^palai-s' || true)"
	if [ "${after_accounts:-0}" -gt "${before_accounts:-0}" ]; then
		ok "a session account was created" "$before_accounts -> $after_accounts"
	else
		no "a session account was created" "count unchanged at ${after_accounts:-0}; has `sudo palai agentd install` been run on this Mac?"
	fi
else
	skip "a session account was created" "run with --with-accounts (needs the sudoers entry)"
fi

hdr "8. CLOSING THE SESSION"
# A FRESH COMMAND ID PER RUN. Commands are idempotent by command_id, so a fixed one made the second
# run of this smoke replay the FIRST run's close — it reported a pass carrying a timestamp from hours
# earlier, against a session it never touched. A smoke that can pass without acting is worse than none.
close="$(api POST "/v1/sessions/$session_id/commands" "{\"kind\":\"close_session\",\"command_id\":\"cmd_smoke_$(date +%s)_$RANDOM\"}")"
if printf '%s' "$close" | grep -q 'command'; then
	ok "close_session accepted" "$(printf '%s' "$close" | head -c 60)"
else
	no "close_session accepted" "$(printf '%s' "$close" | head -c 200)"
fi
if [ "$WITH_ACCOUNTS" -eq 1 ]; then
	sleep 2
	final_accounts="$(dscl . -list /Users 2>/dev/null | grep -c '^palai-s' || true)"
	if [ "${final_accounts:-0}" -le "${before_accounts:-0}" ]; then
		ok "the session account was destroyed" "back to ${final_accounts:-0}"
	else
		no "the session account was destroyed" "${final_accounts:-0} remain; an account that outlives its session is the leak"
	fi
else
	skip "the session account was destroyed" "run with --with-accounts"
fi

printf '\n== RESULT ==\n  %d passed, %d failed, %d unproven\n' "$pass" "$fail" "$unproven"
if [ "$unproven" -gt 0 ]; then
	say "  An UNPROVEN leg is a capability this run could not exercise. It is NOT a pass."
fi
[ "$fail" -eq 0 ] || exit 1
