# compose.yaml interpolation contract. `palai local up` sets these from
# .palai/config.json; this file documents them for a hand-run `docker compose`.
# Secrets are NEVER set here — they live as files under .palai/ and reach the stack
# through the top-level `secrets:` block. Copy to compose.env and edit.

# Absolute path to the .palai data dir (holds ca/, api-key, runner-token, secrets/).
PALAI_HOME=/absolute/path/to/.palai

# Published host ports (bound to 127.0.0.1). Pick free ports.
PALAI_API_PORT=8080
PALAI_RUNNER_PORT=8443
PALAI_PG_PORT=5432
PALAI_S3_PORT=8333

# Reference engine image `palai local up` builds and passes to the runner.
PALAI_ENGINE_IMAGE=palai/reference-engine:local

# Exec-path dispatch. 0 (default) leaves admitted responses queued; 1 runs the full
# create -> engine -> terminal round-trip.
PALAI_DISPATCH_WORKERS=0

# Model provider the exec-path routes to when dispatch is on: "fake" (deterministic, no
# network or credential) or "provider-one" (live OpenAI). PALAI_MODEL sets the model id for
# provider-one (default gpt-4o-mini); the credential is the provider_one_key file secret.
PALAI_MODEL_PROVIDER=fake
PALAI_MODEL=

# Optional: store:false retention TTL (Go duration, e.g. 24h). Empty disables reaping.
PALAI_RETENTION_STORE_FALSE_TTL=

# Optional: the Slack workspace the Socket Mode connect loop dials (a team id, e.g. T0AMPM5JX8U —
# configuration, not a credential). Empty leaves the loop dormant. It needs TWO other things to
# produce a run: a registered connection (POST /v1/slack-connections) and an app-level token stored
# under that connection's app_token_ref. `palai up` does all three from .env.local; set this by hand
# only if you are registering the workspace some other way.
PALAI_SLACK_SOCKET_TEAM_ID=

# PALAI_SECRET_MASTER_KEY_FILE IS NO LONGER AN ENV KNOB and is deliberately not listed here.
# compose.yaml names /run/secrets/master_key literally, on every stack, the way production.yml always
# has. It was interpolated from this file's shell until E21 T2, which meant the DB-backed secret store
# — the only thing that can redeem a *_ref handle — was mounted or not depending on whether `palai up`
# happened to find Slack credentials. What you must keep is the KEY itself: a `openssl rand -hex 32`
# value in $PALAI_HOME/secrets/master-key, which every bring-up mints if it is absent. NEVER re-mint an
# existing one — it seals every secret already stored, and the control-plane fails closed on a bad key.
