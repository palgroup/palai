# compose.yaml interpolation contract. `palai local up` sets these from
# .palai/config.json; this file documents them for a hand-run `docker compose`.
# Secrets are NEVER set here — they live as files under .palai/ and reach the stack
# through the top-level `secrets:` block. Copy to compose.env and edit.

# Absolute path to the .palai data dir (holds ca/, api-key, runner-token, secrets/).
PALAI_HOME=/absolute/path/to/.palai

# Published host ports (bound to 127.0.0.1). Pick free ports.
PALAI_API_PORT=8080
PALAI_RUNNER_PORT=8443
PALAI_PG_PORT=5432
PALAI_S3_PORT=8333

# Reference engine image `palai local up` builds and passes to the runner.
PALAI_ENGINE_IMAGE=palai/reference-engine:local

# Exec-path dispatch. 0 (default) leaves admitted responses queued; 1 runs the full
# create -> engine -> terminal round-trip.
PALAI_DISPATCH_WORKERS=0

# Model provider the exec-path routes to when dispatch is on: "fake" (deterministic, no
# network or credential) or "provider-one" (live OpenAI). PALAI_MODEL sets the model id for
# provider-one (default gpt-4o-mini); the credential is the provider_one_key file secret.
PALAI_MODEL_PROVIDER=fake
PALAI_MODEL=

# Optional: store:false retention TTL (Go duration, e.g. 24h). Empty disables reaping.
PALAI_RETENTION_STORE_FALSE_TTL=

# Optional: the workspace shell tool's sandbox image, PINNED TO A DIGEST (a mutable tag is refused).
# Empty = the stack wires NO shell runner and a shell call fails cleanly, which is what every compose
# deployment has always done. Setting this is what ENABLES the tool.
#
# SINCE A.3 IT REACHES THE RUNNER AS WELL AS THE CONTROL PLANE, and the runner's copy is the one that
# decides a run's shell tool: a command now executes on the machine holding the attempt's lease. The
# control plane's copy governs only detached background tasks.
PALAI_SANDBOX_IMAGE=
# Optional: run shell commands on the machine ITSELF, with no container boundary, no network denial
# and no resource bound. The value is the exact words `unsandboxed-host` — a sentence rather than a
# `1`, because deleting a security boundary should not be reachable by the reflex that switches a
# feature on — and it is mutually exclusive with PALAI_SANDBOX_IMAGE above.
#
# ON A COMPOSE STACK "THE MACHINE" IS THE RUNNER CONTAINER, not your laptop. Reaching a Mac's own
# `xcodebuild`/`simctl`/`axe` needs the runner running natively on that Mac; read
# docs/operations/palai-on-a-mac.md before setting this.
PALAI_SHELL_NATIVE=
# The wall time ONE shell call runs under, and it is listed here rather than somewhere you would find
# it after your first hang. Empty = 10m, measured against real builds rather than picked. The
# container posture REFUSES a non-positive bound, so this must not be set to 0 or to something that is
# not a Go duration. Raise it for a toolchain whose builds legitimately run longer.
PALAI_SANDBOX_WALL_TIME=

# Optional: the Slack workspace the Socket Mode connect loop dials (a team id, e.g. T0AMPM5JX8U —
# configuration, not a credential). Empty leaves the loop dormant. It needs TWO other things to
# produce a run: a registered connection (POST /v1/slack-connections) and an app-level token stored
# under that connection's app_token_ref. `palai up` does all three from .env.local; set this by hand
# only if you are registering the workspace some other way.
PALAI_SLACK_SOCKET_TEAM_ID=

# PALAI_SECRET_MASTER_KEY_FILE IS NO LONGER AN ENV KNOB and is deliberately not listed here.
# compose.yaml names /run/secrets/master_key literally, on every stack, the way production.yml always
# has. It was interpolated from this file's shell until E21 T2, which meant the DB-backed secret store
# — the only thing that can redeem a *_ref handle — was mounted or not depending on whether `palai up`
# happened to find Slack credentials. What you must keep is the KEY itself: a `openssl rand -hex 32`
# value in $PALAI_HOME/secrets/master-key, which every bring-up mints if it is absent. NEVER re-mint an
# existing one — it seals every secret already stored, and the control-plane fails closed on a bad key.

# Optional: the GitHub App an APPROVED publication publishes through (E22 T4, §0.2). Without all three
# the control-plane wires NO publisher, which is not an error anywhere — the agent still proposes a push,
# a human still presses Approve, the message still says "Approved", and the branch is never pushed. The
# two ids are identifiers and ride this file; the PRIVATE KEY does not — `palai up` copies the file named
# by PALAI_GITHUB_APP_PRIVATE_KEY_FILE in .env.local into $PALAI_HOME/secrets/github-app-key (0600), and
# compose mounts it as the github_app_key file secret at a path written literally in compose.yaml.
#
# A hand-run compose (no `palai up`) must create that slot itself — even EMPTY, because compose fails
# outright on a missing mount source — and put the PEM there to publish anything:
#   install -m 600 /path/to/github-app.pem "${PALAI_HOME}/secrets/github-app-key"
PALAI_GITHUB_APP_ID=
PALAI_GITHUB_APP_INSTALLATION_ID=

# owner/repo, for PULL REQUESTS only: a push resolves its remote from the repository binding, but the PR
# client needs the provider-side repository. Absent, pushes publish and every approved pull request
# answers "no pull-request client wired". `palai up` derives it from PALAI_GIT_REPO (or the clone URL).
PALAI_GITHUB_REPO=
