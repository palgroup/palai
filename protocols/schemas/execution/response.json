{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.palai.dev/execution/response.json",
  "title": "Response",
  "type": "object",
  "required": ["id", "object", "status", "created_at", "model", "output", "usage"],
  "properties": {
    "id": {"$ref": "../common/id.json#/$defs/response_id"},
    "object": {"type": "string", "const": "response"},
    "project_id": {"$ref": "../common/id.json#/$defs/project_id"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "metadata": {"type": "object", "maxProperties": 64},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "status": {"type": "string"},
    "model": {"type": "string"},
    "output": {"type": "array", "items": {"$ref": "content.json"}},
    "usage": {"$ref": "usage.json"},
    "error": {"oneOf": [{"$ref": "../common/problem.json"}, {"type": "null"}]},
    "session_id": {"$ref": "../common/id.json#/$defs/session_id"},
    "run_id": {"$ref": "../common/id.json#/$defs/run_id"},
    "agent_revision_id": {
      "type": "string",
      "description": "The agent revision this run RESOLVED to, absent when no agent steered it. response-create.json promises exactly this — a request naming `agent_id` is pinned at admission to that agent's highest published revision 'so the run is reproducible from its recorded agent_revision_id even though the request did not name one' — and until 2026-08-07 the promise had no read: the column was written on `runs` by 000019, the resolution happened, and every surface answered null. Reproducing a run means naming the revision that answered, so the id has to leave the plane."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "known_statuses": {
      "enum": ["queued", "provisioning", "in_progress", "waiting_for_tool",
        "waiting_for_approval", "waiting_for_input", "completed", "failed",
        "canceled", "timed_out", "budget_exceeded"]
    }
  }
}
