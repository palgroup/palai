# Build context for the control-plane and runner images is the repo root
# (deploy/compose/*.Dockerfile). Keep it to the Go module: drop VCS metadata, the
# Python engine virtualenv, caches, and heavy trees the Go build never imports.
.git
**/.venv
**/__pycache__
**/.pytest_cache
**/node_modules
spikes
docs
# Release output (`scripts/release/build.sh --out dist/release`): the image tars it just saved would
# otherwise be fed back into the next image build's context.
dist
.superpowers
*.log
