{
  // The EMITTING configuration. tsconfig.json type-checks the workspace copy, which Node runs with
  // --experimental-strip-types and which the console imports straight from src; it therefore sets
  // noEmit and allowImportingTsExtensions. A published package cannot ship .ts, so this file exists
  // to turn the same sources into JavaScript plus declarations without disturbing that.
  //
  // rewriteRelativeImportExtensions IS THE WHOLE REASON THIS IS POSSIBLE. Every relative import in
  // src ends in ".ts" (76 of them, zero ".js"), because the workspace runs the sources directly.
  // TypeScript preserves module specifiers verbatim on emit, so without this flag dist/index.js would
  // import "./client.ts" — a file that is not in the package — and every consumer would fail at the
  // first import with a message about a missing module rather than about the real cause.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",

    // noEmitOnError, because tsc emits by default even when it reported errors. Without it a build
    // with 51 type errors still fills dist/ and `pnpm pack` ships it — a package that installs
    // cleanly and fails at the consumer's first call. A broken build must produce no package at all.
    "noEmitOnError": true
  },
  // Tests are type-checked by tsconfig.json and are not part of the published package.
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
